<!--  Product single Swatch images -->
{% assign arr_swatch = 'Color' | split: ',' %}
			{%- assign tpl =  template | replace: '.', ' ' | truncatewords: 1, '' | handle  -%}
		 	 
		 		{%- if   tpl != 'product' and product == blank-%}
		 			{% assign product  =  collections['all'].products.first  %}
		 		{%- endif -%}
		 	 

			{% assign first_variant = product.selected_or_first_available_variant %}{%- assign color_names = '' | split: ',' -%}
		{%- assign color_names_downcase = '' | split: ',' -%}
		{%- assign color_values = '' | split: ','  -%}
		{%- if shop.metafields.layouthub and shop.metafields.layouthub.colors and shop.metafields.layouthub.colors contains '|' -%}
			{% assign colors = shop.metafields.layouthub.colors | split: '|' %}
			{%- assign color_names = colors | first | strip | split: ',' -%}
			{%- assign color_names_downcase = colors | first | strip | downcase | split: ',' -%}
			{%- assign color_values = colors | last | strip | split: ',' -%}
		 {%- endif -%}<div  class="lh-wrapper lh-product-single" data-pid="{{- product.id -}}" data-money-format='{{shop.money_format | url_encode }}' data-vid_url="{%- if tpl != 'product' -%}
				{%- assign vid_url = false -%}
			{%- else -%}
				{%- assign vid_url = true -%}
			{%- endif -%}
			{{- vid_url -}}">
		<div class="lh-container">
			<div class="lh-details-product">
				<div class="lh-row lh-align-start">
					<div class="lh-col-md-6">
					<div class="lh-product-sync-images use-zoom-no lh-promote-no" data-hub-attr-state="class%3D%22lh-product-sync-images%20use-zoom-%257B%253A%257Bsection.settings.use_zoom%257D%253A%257D%20lh-promote-%257B%253A%257Bsection.settings.show_badge%257D%253A%257D%22"  data-hub-attr-use_zoom  data-hub-attr-show_badge >
						<!-- <include data-live-use_zoom data-live-show_nav data-live-use_zoom data-name="product-images" data-id="1">  
 <div class="lh-details-images  use-zoom-no show-nav-no" data-hub-attr-state="class%3D%22lh-details-images%20%20use-zoom-%257B%253A%257Bsection.settings.use_zoom%257D%253A%257D%20show-nav-%257B%253A%257Bsection.settings.show_nav%257D%253A%257D%22"  data-hub-attr-use_zoom  data-hub-attr-show_nav >
  <div class="lh-big-slide" >
        <div class="lh-big_slide-lg">
              <div class="lh-label lh-absolute">
				{%- assign compare_at_price = product.compare_at_price -%}
				{%- assign price = product.price -%}
				{%- assign price_varies = product.price_varies -%}
				{%- assign available = product.available -%}
				{%-assign on_new = false-%}
				{%-unless product.tags contains 'notnew'%}
						{%-assign now_date_int = "now" | date: "%j" | plus: 0-%}
						{%-assign now_year_int = "now" | date: '%Y' | plus: 0-%}
						{%-assign pub_date_int = product.published_at | date: "%j" | plus: 0-%}
