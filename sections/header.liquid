{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
      this.onScrollHandler = this.onScroll.bind(this);
      this.onResizeHandler = this.onResize.bind(this);
      this.onSectionLoadHandler = this.onSectionLoad.bind(this);
      this.currentScrollTop = 0;
      this.scrollFrame = null;
      this.lastDirectionChange = 0;
    }

    connectedCallback() {
      this.header = this.closest('.section-header') || document.querySelector('.section-header');
      this.wrapper = this.matches('.header-wrapper') ? this : this.querySelector('.header-wrapper');
      this.predictiveSearch = this.querySelector('predictive-search');
      this.headerIsAlwaysSticky = true;
      this.headerBounds = {};
      this.isMobile = window.matchMedia('(max-width: 990px)');
      this.isDesignMode = document.documentElement.classList.contains('shopify-design-mode');

      this.setHeaderHeight();
      this.setAnnouncementHeight();
      this.syncHeroReference();
      this.updateHeaderState(true);

      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
      window.addEventListener('resize', this.onResizeHandler, { passive: true });
      document.addEventListener('shopify:section:load', this.onSectionLoadHandler);
      this.addEventListener('preventHeaderReveal', this.preventReveal.bind(this));

      window.requestAnimationFrame(() => {
        this.syncHeroReference();
        this.setAnnouncementHeight();
        this.updateHeaderState(true);
      });
    }

    setHeaderHeight() {
      if (!this.header) return;
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    setAnnouncementHeight() {
      const announcement = this.closest('.shopify-section-group-header-group')?.querySelector('.announcement-bar');
      const announcementHeight = announcement?.closest('.shopify-section')?.getBoundingClientRect().height || 0;
      document.documentElement.style.setProperty('--header-announcement-height', `${Math.round(announcementHeight)}px`);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
      window.removeEventListener('resize', this.onResizeHandler);
      document.removeEventListener('shopify:section:load', this.onSectionLoadHandler);
      if (this.scrollFrame) window.cancelAnimationFrame(this.scrollFrame);
    }

    preventReveal() {
      this.preventMobileReveal = true;
      window.clearTimeout(this.preventRevealTimeout);
      this.preventRevealTimeout = window.setTimeout(() => {
        this.preventMobileReveal = false;
      }, 200);
    }

    onSectionLoad() {
      this.syncHeroReference();
      this.setHeaderHeight();
      this.setAnnouncementHeight();
      this.updateHeaderState(true);
    }

    onResize() {
      this.setHeaderHeight();
      this.setAnnouncementHeight();
      this.syncHeroReference();
      this.updateHeaderState(true);
    }

    syncHeroReference() {
      this.hero = null;
      this.heroSection = null;
      if (this.getAttribute('data-page-type') !== 'index' || this.wrapper?.dataset.headerTransparent !== 'true') return;
      this.hero = document.querySelector('#MainContent [data-luxury-hero]');
      this.heroSection = this.hero?.closest('.shopify-section') || null;
    }

    onScroll() {
      if (this.predictiveSearch?.isOpen) return;
      if (this.scrollFrame) return;

      this.scrollFrame = window.requestAnimationFrame(() => {
        this.scrollFrame = null;
        this.updateHeaderState(false);
      });
    }

    updateHeaderState(force) {
      if (!this.header) return;

      const scrollTop = Math.max(0, window.pageYOffset || document.documentElement.scrollTop);
      const delta = scrollTop - this.currentScrollTop;
      const atTop = scrollTop <= 4;
      const heroEnd = this.heroSection ? this.heroSection.offsetTop + this.heroSection.offsetHeight : 0;
      const heroHasEnded = Boolean(this.heroSection && scrollTop >= Math.max(0, heroEnd - this.header.offsetHeight));
      const mobile = this.isMobile.matches;
      const hasHero = Boolean(this.hero);

      this.header.classList.toggle('header--hero', hasHero);

      if (hasHero && !heroHasEnded) {
        this.header.classList.remove('header--scrolled', 'header--sticky');
        this.header.classList.remove('header--mobile-hidden');
      } else {
        this.header.classList.toggle('header--scrolled', hasHero && heroHasEnded);
        this.header.classList.toggle('header--sticky', !hasHero || heroHasEnded);

        if (mobile && !atTop && !this.preventMobileReveal && !force) {
          if (delta > 4 && scrollTop > this.header.offsetHeight) {
            this.header.classList.add('header--mobile-hidden');
            this.closeOpenMenus();
          } else if (delta < -4) {
            this.header.classList.remove('header--mobile-hidden');
          }
        } else if (atTop || force) {
          this.header.classList.remove('header--mobile-hidden');
        }
      }

      if (!mobile) {
        this.header.classList.remove('header--mobile-hidden');
      }

      this.currentScrollTop = scrollTop;
    }

    closeOpenMenus() {
      this.header?.querySelectorAll('header-menu details[open]').forEach(details => {
        details.removeAttribute('open');
        details.querySelector('summary')?.setAttribute('aria-expanded', 'false');
      });

      this.closeSearchModal();
    }

    closeSearchModal() {
      this.header?.querySelectorAll('details-modal').forEach(searchModal => {
        if (searchModal.isOpen?.()) searchModal.close(false);
      });
    }
  }

  customElements.define('sticky-header', StickyHeader);

  const enhanceHeaderMenus = () => {
    document.querySelectorAll('header-menu > details').forEach((details) => {
      if (details.dataset.hoverEnhanced === 'true') return;
      details.dataset.hoverEnhanced = 'true';
      const menu = details.closest('header-menu');
      const summary = details.querySelector(':scope > summary');

      const open = () => {
        if (!window.matchMedia('(min-width: 991px)').matches) return;
        details.setAttribute('open', '');
        summary?.setAttribute('aria-expanded', 'true');
      };

      const close = () => {
        if (details.matches(':hover') || details.contains(document.activeElement)) return;
        details.removeAttribute('open');
        summary?.setAttribute('aria-expanded', 'false');
      };

      menu?.addEventListener('mouseenter', open);
      menu?.addEventListener('mouseleave', close);
      menu?.addEventListener('focusin', open);
      menu?.addEventListener('focusout', () => window.setTimeout(close, 0));
    });
  };

  enhanceHeaderMenus();
  document.addEventListener('shopify:section:load', enhanceHeaderMenus);

  const enhanceHeaderDrawerLinks = () => {
    document.querySelectorAll('header-drawer .menu-drawer__menu-link').forEach((link) => {
      if (link.dataset.navigationEnhanced === 'true') return;
      link.dataset.navigationEnhanced = 'true';
      link.addEventListener('click', (event) => event.stopPropagation());
    });
  };

  enhanceHeaderDrawerLinks();
  document.addEventListener('shopify:section:load', enhanceHeaderDrawerLinks);

  document.querySelectorAll('header-drawer').forEach((drawer) => {
    if (drawer.dataset.headerEnhanced === 'true') return;
    drawer.dataset.headerEnhanced = 'true';
    drawer.querySelectorAll('.menu-drawer__submenu-close-all').forEach((closeButton) => {
      closeButton.addEventListener('click', (event) => {
        const headerDrawer = event.currentTarget.closest('header-drawer');
        const mainDetails = headerDrawer?.querySelector(':scope > details');
        const summary = mainDetails?.querySelector(':scope > summary');
        if (headerDrawer && mainDetails && summary) headerDrawer.closeMenuDrawer(event, summary);
      });
    });
  });
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

