<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }


  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 991px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .header__heading-logo--transparent {
    display: none;
  }

  .header__menu-label a {
    color: inherit;
    text-decoration: inherit;
  }

  .header__menu-label a:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: 0.3rem;
  }

  .menu-drawer__menu-item--has-children {
    position: relative;
    display: flex;
    align-items: center;
    list-style: none;
  }

  .menu-drawer__menu-item--has-children::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__menu-link {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 4.8rem;
    color: inherit;
    text-decoration: none;
  }

  .menu-drawer__submenu-toggle {
    display: grid;
    flex: 0 0 4.4rem;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    place-items: center;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .menu-drawer__submenu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__submenu-toggle .icon-arrow {
    position: static;
    width: 1.6rem;
    height: 1.6rem;
    transform: none;
  }

  .menu-drawer__submenu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.6rem;
    padding: 0 1.2rem 0 1.6rem;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.1);
  }

  .menu-drawer__submenu-header .menu-drawer__close-button {
    flex: 1 1 auto;
    width: auto;
    margin: 0;
    padding: 1.2rem 0;
  }

  .menu-drawer__submenu-close-all {
    display: grid;
    flex: 0 0 4.4rem;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    place-items: center;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .menu-drawer__submenu-close-all .icon {
    width: 1.8rem;
    height: 1.8rem;
  }

  @media screen and (min-width: 991px) {
    header-drawer {
      display: none;
    }

    .header__inline-menu {
      display: block;
    }
  }

  @media screen and (max-width: 990px) {
    .header__inline-menu {
      display: none;
    }

    .header__icon--account {
      display: none !important;
    }

    .header__icon,
    .header__icon--cart .icon {
      min-width: 4.4rem;
      min-height: 4.4rem;
    }

    .menu-drawer {
      top: calc(100% + 0.8rem);
      left: 0.8rem;
      width: calc(100vw - 1.6rem);
      height: calc(100dvh - var(--header-bottom-position, 6.8rem) - 1.6rem);
      max-height: calc(100dvh - var(--header-bottom-position, 6.8rem) - 1.6rem);
      border: 0.1rem solid rgba(var(--color-foreground), 0.12);
      border-radius: var(--header-drawer-radius, 1.6rem);
      box-shadow: 0 1.6rem 4rem rgba(0, 0, 0, 0.16);
      overscroll-behavior: contain;
    }

    .menu-drawer,
    .menu-drawer__submenu {
      transition-duration: var(--header-drawer-duration);
    }

    .menu-drawer__navigation-container {
      overflow: hidden;
      overscroll-behavior: contain;
    }

    .menu-drawer__navigation {
      min-height: 0;
      padding: 1.2rem 0 2rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .menu-drawer__menu-item--has-children {
      padding: 0 1.2rem 0 2rem;
      font-size: 1.8rem;
    }

    .menu-drawer__menu-link,
    .menu-drawer__menu-item {
      min-height: 5.6rem;
      padding-top: 0;
      padding-bottom: 0;
      font-size: 1.8rem;
    }

    .menu-drawer__submenu {
      border: 0;
      border-radius: var(--header-drawer-radius, 1.6rem);
      overscroll-behavior: contain;
    }

    .menu-drawer__inner-submenu {
      overflow-x: hidden;
      overflow-y: auto;
      overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch;
    }

    .menu-drawer__utility-links {
      flex-shrink: 0;
      padding: 1.6rem 2rem calc(1.6rem + env(safe-area-inset-bottom));
      border-top: 0.1rem solid rgba(var(--color-foreground), 0.1);
    }

    .menu-drawer .list-social__link {
      min-width: 4.4rem;
      min-height: 4.4rem;
    }

    .menu-drawer-container > summary::before {
      top: 100%;
      left: 0;
      width: 100vw;
      height: calc(100dvh - var(--header-bottom-position, 6.8rem));
      background: rgba(0, 0, 0, 0.42);
      backdrop-filter: blur(0.2rem);
      transition-duration: var(--header-drawer-duration);
    }

    .menu-drawer-container > details[open] > .menu-drawer,
    .menu-drawer-container > details[open].menu-opening > .menu-drawer {
      transform: translateX(0);
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-drawer,
    .menu-drawer__submenu,
    .section-header,
    .header-wrapper,
    .header__heading-logo-wrapper {
      transition-duration: 0.01ms !important;
    }
  }
</style>

{%- style -%}
  .header {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  .section-header {
    position: sticky; /* This is for fixing a Safari z-index issue. PR #2147 */
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  @media screen and (min-width: 990px) {
    .header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  :root {
    --header-sticky-margin: {{ section.settings.sticky_horizontal_margin }}px;
    --header-sticky-top: {{ section.settings.sticky_top_offset }}px;
    --header-sticky-radius: {{ section.settings.sticky_border_radius }}px;
    --header-sticky-background: {{ section.settings.sticky_background }};
    --header-sticky-text: {% if section.settings.sticky_color_scheme == 'light' %}#fff{% else %}#111{% endif %};
    --header-transparent-text: {% if section.settings.transparent_color_scheme == 'light' %}#fff{% else %}#111{% endif %};
    --header-sticky-shadow: {{ section.settings.sticky_shadow }};
    --header-drawer-radius: {{ section.settings.mobile_drawer_radius }}px;
    --header-drawer-duration: {{ section.settings.mobile_drawer_duration }}ms;
  }

  .section-header {
    z-index: 10;
    transition: transform var(--header-drawer-duration) cubic-bezier(.22, 1, .36, 1), top var(--header-drawer-duration) cubic-bezier(.22, 1, .36, 1), margin var(--header-drawer-duration) ease;
  }

  .section-header .header-wrapper {
    transition: background-color var(--header-drawer-duration) ease, color var(--header-drawer-duration) ease, border-color var(--header-drawer-duration) ease, box-shadow var(--header-drawer-duration) ease, border-radius var(--header-drawer-duration) ease;
  }

  .section-header.header--hero:not(.header--scrolled) .header-wrapper .header__menu-item,
  .section-header.header--hero:not(.header--scrolled) .header-wrapper .header__active-menu-item,
  .section-header.header--hero:not(.header--scrolled) .header-wrapper .header__icon,
  .section-header.header--hero:not(.header--scrolled) .header-wrapper .header__heading-link,
  .section-header.header--hero:not(.header--scrolled) .header-wrapper .header__heading-link .h2 {
    color: var(--header-transparent-text);
  }

  .header__heading-logo--transparent {
    display: none;
  }

  @media screen and (min-width: 991px) {
    body:has(#MainContent [data-luxury-hero]) .section-header:not(.header--scrolled) {
      position: absolute;
      top: var(--header-announcement-height, 0px);
      right: 0;
      left: 0;
      width: 100%;
      margin: 0;
    }

    body:has(#MainContent [data-luxury-hero]) .section-header:not(.header--scrolled) .header-wrapper[data-header-transparent='true'] {
      color: var(--header-transparent-text);
      background: transparent;
      border-color: transparent;
      box-shadow: none;
    }
  }

  @media screen and (max-width: 990px) {
    body:has(#MainContent [data-luxury-hero]) .section-header:not(.header--scrolled) {
      position: absolute;
      top: var(--header-announcement-height, 0px);
      right: 0;
      left: 0;
      width: 100%;
      margin: 0;
    }

    body:has(#MainContent [data-luxury-hero]) .section-header:not(.header--scrolled) .header-wrapper[data-header-transparent='true'] {
      color: var(--header-transparent-text);
      background: transparent;
      border-color: transparent;
      box-shadow: none;
    }
  }

  .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default {
    {% if section.settings.transparent_logo != blank %}display: none;{% endif %}
  }

  .section-header.header--hero:not(.header--scrolled) .header__heading-logo--transparent {
    {% if section.settings.transparent_logo != blank %}display: inline-block;{% endif %}
  }

  @media screen and (min-width: 991px) {
    .section-header {
      position: sticky;
      top: var(--header-sticky-top);
      margin-right: var(--header-sticky-margin);
      margin-left: var(--header-sticky-margin);
    }

    .section-header.header--hero:not(.header--scrolled) {
      position: absolute;
      top: var(--header-announcement-height, 0px);
      right: 0;
      left: 0;
      width: 100%;
      margin: 0;
    }

    .section-header.header--hero:not(.header--scrolled) .header-wrapper {
      color: var(--header-transparent-text);
      background: transparent;
      border-color: transparent;
      box-shadow: none;
    }

    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default:not(:only-child) {
      display: none;
    }

    .section-header.header--hero.header--scrolled,
    .section-header.header--sticky {
      position: fixed;
      top: var(--header-sticky-top);
      right: var(--header-sticky-margin);
      left: var(--header-sticky-margin);
      width: auto;
      margin: 0;
    }

    .section-header.header--hero.header--scrolled .header-wrapper,
    .section-header.header--sticky .header-wrapper {
      color: var(--header-sticky-text);
      background: var(--header-sticky-background);
      border-color: rgba(17, 17, 17, 0.08);
      border-radius: var(--header-sticky-radius);
      box-shadow: var(--header-sticky-shadow);
    }

    .section-header.header--hero.header--scrolled .header-wrapper .header__menu-item,
    .section-header.header--hero.header--scrolled .header-wrapper .header__active-menu-item,
    .section-header.header--hero.header--scrolled .header-wrapper .header__icon,
    .section-header.header--hero.header--scrolled .header-wrapper .header__heading-link,
    .section-header.header--hero.header--scrolled .header-wrapper .header__heading-link .h2,
    .section-header.header--sticky .header-wrapper .header__menu-item,
    .section-header.header--sticky .header-wrapper .header__active-menu-item,
    .section-header.header--sticky .header-wrapper .header__icon,
    .section-header.header--sticky .header-wrapper .header__heading-link,
    .section-header.header--sticky .header-wrapper .header__heading-link .h2 {
      color: var(--header-sticky-text);
    }

    .section-header.header--hero.header--scrolled .header__heading-logo--transparent,
    .section-header.header--sticky .header__heading-logo--transparent {
      {% if section.settings.transparent_logo != blank %}display: none;{% endif %}
    }

    .section-header.header--hero.header--scrolled .header__heading-logo--default,
    .section-header.header--sticky .header__heading-logo--default {
      {% if settings.logo != blank %}display: inline-block;{% endif %}
    }
  }

  @media screen and (max-width: 990px) {
    .section-header {
      position: sticky;
      top: 0;
      margin: 0;
    }

    .section-header.header--hero:not(.header--scrolled) {
      position: absolute;
      top: var(--header-announcement-height, 0px);
      right: 0;
      left: 0;
      width: 100%;
    }

    .section-header.header--hero:not(.header--scrolled) .header-wrapper {
      color: var(--header-transparent-text);
      background: transparent;
      border-color: transparent;
      box-shadow: none;
    }

    .section-header.header--hero.header--scrolled,
    .section-header.header--sticky {
      position: fixed;
      top: 0;
      right: 0;
      left: 0;
      width: 100%;
      margin: 0;
    }

    .section-header.header--hero.header--scrolled .header-wrapper,
    .section-header.header--sticky .header-wrapper {
      color: var(--header-sticky-text);
      background: var(--header-sticky-background);
      border-color: rgba(17, 17, 17, 0.08);
      border-radius: 0;
      box-shadow: var(--header-sticky-shadow);
    }

    .section-header.header--hero.header--scrolled .header-wrapper .header__menu-item,
    .section-header.header--hero.header--scrolled .header-wrapper .header__active-menu-item,
    .section-header.header--hero.header--scrolled .header-wrapper .header__icon,
    .section-header.header--hero.header--scrolled .header-wrapper .header__heading-link,
    .section-header.header--hero.header--scrolled .header-wrapper .header__heading-link .h2,
    .section-header.header--sticky .header-wrapper .header__menu-item,
    .section-header.header--sticky .header-wrapper .header__active-menu-item,
    .section-header.header--sticky .header-wrapper .header__icon,
    .section-header.header--sticky .header-wrapper .header__heading-link,
    .section-header.header--sticky .header-wrapper .header__heading-link .h2 {
      color: var(--header-sticky-text);
    }

    .section-header.header--mobile-hidden {
      transform: translateY(calc(-100% - 0.8rem));
      pointer-events: none;
    }

    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default:not(:only-child),
    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default {
      {% if section.settings.transparent_logo != blank %}display: none;{% endif %}
    }

    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--transparent {
      {% if section.settings.transparent_logo != blank %}display: inline-block;{% endif %}
    }
  }

  {% if section.settings.transparent_color_scheme == 'light' and section.settings.transparent_logo == blank %}
    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default {
      filter: brightness(0) invert(1);
    }
  {% endif %}
{%- endstyle -%}

<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
{%- if settings.cart_type == "drawer" -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-reset" class="icon icon-close"  fill="none" viewBox="0 0 18 18" stroke="currentColor">
    <circle r="8.5" cy="9" cx="9" stroke-opacity="0.2"/>
    <path d="M6.82972 6.82915L1.17193 1.17097" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
    <path d="M1.22896 6.88502L6.77288 1.11523" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

<sticky-header data-sticky-type="{{ section.settings.sticky_header_type }}" data-page-type="{{ request.page_type }}" class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}" data-header-transparent="{{ section.settings.transparent_header }}" data-header-transparent-scheme="{{ section.settings.transparent_color_scheme }}" data-header-sticky-scheme="{{ section.settings.sticky_color_scheme }}">
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}">
    {%- if section.settings.menu != blank -%}
      <header-drawer data-breakpoint="mobile">
        <details id="Details-menu-drawer-container" class="menu-drawer-container" data-header-main-drawer>
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}" data-header-menu-toggle>
            <span>
              {% render 'icon-hamburger' %}
              {% render 'icon-close' %}
            </span>
          </summary>
          <div id="menu-drawer" class="gradient menu-drawer motion-reduce" tabindex="-1" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation">
                  {% render 'header-menu-drawer', links: section.settings.menu.links, section_id: section.id, level: 0 %}
                </nav>
                <div class="menu-drawer__utility-links">
                  {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
                    <div class="menu-drawer__localization header__localization">
                      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
                        <localization-form>
                          {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                            <div class="no-js-hidden">
                              <h2 class="visually-hidden" id="HeaderCountryMobileLabel">{{ 'localization.country_label' | t }}</h2>
                              {%- render 'country-localization', localPosition: 'HeaderCountryMobile' -%}
                            </div>
                          {%- endform -%}
                        </localization-form>
                      {% endif %}

                      {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
                        <localization-form>
                          {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                            <div class="no-js-hidden">
                              <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">{{ 'localization.language_label' | t }}</h2>
                              {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                            </div>
                          {%- endform -%}
                        </localization-form>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <ul class="list list-social list-unstyled" role="list">
                    {%- if settings.social_twitter_link != blank -%}
