{% liquid
  assign slide_count = section.blocks.size
  assign autoplay_interval = section.settings.autoplay_interval | times: 1000
  assign heading_font = section.settings.heading_font
%}

<section
  id="LuxuryHero-{{ section.id }}"
  class="luxury-hero luxury-hero--content-{{ section.settings.content_position }}"
  data-luxury-hero
  data-section-id="{{ section.id }}"
  data-slide-count="{{ slide_count }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-interval="{{ autoplay_interval }}"
  data-transition-duration="{{ section.settings.transition_duration }}"
  style="
    --luxury-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --luxury-hero-transition: {{ section.settings.transition_duration }}ms;
    --luxury-hero-zoom-duration: {{ autoplay_interval }}ms;
  "
>
  <div class="luxury-hero__slider swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          class="luxury-hero__slide swiper-slide"
          data-block-id="{{ block.id }}"
          role="group"
          aria-label="Slide {{ forloop.index }} of {{ forloop.length }}"
          style="--luxury-slide-background: {{ block.settings.background_color | default: '#9baa83' }};"
          {{ block.shopify_attributes }}
        >
          <div class="luxury-hero__media">
            {% if block.settings.image != blank %}
              <picture class="luxury-hero__picture">
                {% if block.settings.mobile_image != blank %}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.mobile_image | image_url: width: 1920 }}"
                  >
                {% endif %}
                {% if forloop.first %}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag:
                      widths: '750, 1100, 1500, 2000, 2500, 3000, 3840',
                      sizes: '100vw',
                      class: 'luxury-hero__image',
                      loading: 'eager',
                      fetchpriority: 'high'
                  }}
                {% else %}
                  {{
                    block.settings.image
                    | image_url: width: 3840
                    | image_tag:
                      widths: '750, 1100, 1500, 2000, 2500, 3000, 3840',
                      sizes: '100vw',
                      class: 'luxury-hero__image',
                      loading: 'lazy'
                  }}
                {% endif %}
              </picture>
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'luxury-hero__image luxury-hero__placeholder' }}
            {% endif %}
          </div>

          <div class="luxury-hero__shade"></div>

          <div class="luxury-hero__content">
            {% if block.settings.text != blank %}
              <div class="luxury-hero__text rte">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.heading != blank %}
              <h2 class="luxury-hero__heading">{{ block.settings.heading }}</h2>
            {% endif %}

            {% if block.settings.button_label != blank %}
              {% liquid
                assign cta_url = block.settings.button_link
                if cta_url == blank
                  assign cta_url = routes.all_products_collection_url | default: '/collections/all'
                endif
              %}
              <a class="luxury-hero__button" href="{{ cta_url }}">
                <span>{{ block.settings.button_label | escape }}</span>
                <span class="luxury-hero__button-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false">
                    <path d="M7.5 3.75 13.75 10 7.5 16.25"></path>
                  </svg>
                </span>
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="luxury-hero__slide swiper-slide luxury-hero__slide--empty">
          <div class="luxury-hero__media">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'luxury-hero__image luxury-hero__placeholder' }}
          </div>
          <div class="luxury-hero__shade"></div>
          <div class="luxury-hero__content">
            <h2 class="luxury-hero__heading">{{ 'sections.slideshow.load_slide' | t }}</h2>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if slide_count > 1 and section.settings.show_navigation %}
    <div class="luxury-hero__controls" aria-label="Slideshow controls">
      <div class="luxury-hero__status">
        <span class="luxury-hero__current" aria-live="polite">1</span>
        <span aria-hidden="true">/</span>
        <span class="luxury-hero__total">{{ slide_count }}</span>
      </div>

      <span class="luxury-hero__progress" aria-hidden="true">
        <span class="luxury-hero__progress-fill"></span>
      </span>

      <div class="luxury-hero__navigation">
        <button class="luxury-hero__arrow luxury-hero__previous" type="button" aria-label="Previous slide">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M12.75 4.75 7.5 10l5.25 5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </button>
        <button class="luxury-hero__arrow luxury-hero__next" type="button" aria-label="Next slide">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="m7.25 4.75 5.25 5.25-5.25 5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
    </div>
  {% endif %}
</section>

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 0;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  #shopify-section-{{ section.id }} ~ .shopify-section {
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} + .shopify-section {
    margin-top: -3.4rem;
    overflow: clip;
    background: rgb(var(--color-background));
    border-radius: 2rem 2rem 0 0;
  }

  #LuxuryHero-{{ section.id }} {
    position: relative;
    left: 50%;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    min-height: 38rem;
    margin-left: -50vw;
    overflow: hidden;
    color: #fff;
    background: #1d2118;
    isolation: isolate;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slider,
  #LuxuryHero-{{ section.id }} .swiper-wrapper,
  #LuxuryHero-{{ section.id }} .luxury-hero__slide {
    width: 100%;
    height: 100%;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slider.swiper {
    position: relative;
    z-index: 1;
    display: block;
    overflow: hidden;
  }

  #LuxuryHero-{{ section.id }} .swiper-wrapper {
    position: relative;
    z-index: 1;
    display: flex;
    box-sizing: content-box;
    transition-property: transform;
    transition-timing-function: ease !important;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slide {
    position: relative;
    display: block;
    flex-shrink: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--luxury-hero-transition) ease;
  }

  #LuxuryHero-{{ section.id }} .swiper-fade .luxury-hero__slide {
    pointer-events: none;
    transition-property: opacity;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slide.swiper-slide-active {
    opacity: 1;
    pointer-events: auto;
  }

  #LuxuryHero-{{ section.id }} .swiper-notification {
    position: absolute;
    z-index: -1000;
    opacity: 0;
    pointer-events: none;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__media,
  #LuxuryHero-{{ section.id }} .luxury-hero__shade {
    position: absolute;
    inset: 0;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__media {
    background: var(--luxury-slide-background, #9baa83);
    transform: scale(1.1);
    transform-origin: center;
    transition: transform 0s linear var(--luxury-hero-transition);
    will-change: transform;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slide.swiper-slide-active .luxury-hero__media {
    transform: scale(1);
    transition: transform var(--luxury-hero-zoom-duration) cubic-bezier(.2, .72, .24, 1);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__placeholder {
    background: #9baa83;
    fill: rgba(255, 255, 255, .35);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__shade {
    z-index: 1;
    background: rgba(0, 0, 0, var(--luxury-hero-overlay));
    pointer-events: none;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__content {
    position: absolute;
    z-index: 2;
    left: max(5rem, calc((100vw - 144rem) / 2));
    top: clamp(18rem, 35.5vh, 40rem);
    bottom: auto;
    width: min(52rem, calc(100vw - 4rem));
  }

  #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_center .luxury-hero__content {
    right: auto;
    left: 50%;
    text-align: center;
    transform: translateX(-50%);
  }

  #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_center .luxury-hero__heading,
  #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_center .luxury-hero__text {
    margin-right: auto;
    margin-left: auto;
  }

  #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_right .luxury-hero__content {
    right: max(5rem, calc((100vw - 144rem) / 2));
    left: auto;
    text-align: right;
  }

  #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_right .luxury-hero__heading,
  #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_right .luxury-hero__text {
    margin-left: auto;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__content > .luxury-hero__text,
  #LuxuryHero-{{ section.id }} .luxury-hero__content > .luxury-hero__heading {
    opacity: 0;
    transform: translate3d(0, 2.5rem, 0);
    transition: opacity 1500ms cubic-bezier(.16, 1, .3, 1), transform 1500ms cubic-bezier(.16, 1, .3, 1);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__content > .luxury-hero__button {
    opacity: 0;
    transform: translate3d(0, 2.5rem, 0);
  }

  #LuxuryHero-{{ section.id }}[data-initialized='true'] .luxury-hero__text,
  #LuxuryHero-{{ section.id }}[data-initialized='true'] .luxury-hero__heading,
  #LuxuryHero-{{ section.id }}[data-initialized='true'] .luxury-hero__button {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  #LuxuryHero-{{ section.id }}[data-initialized='true'] .luxury-hero__text {
    transition-delay: 50ms;
  }

  #LuxuryHero-{{ section.id }}[data-initialized='true'] .luxury-hero__heading {
    transition-delay: 150ms;
  }

  #LuxuryHero-{{ section.id }}[data-initialized='true'] .luxury-hero__button {
    transition-delay: 0ms, 250ms, 250ms;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__heading {
    max-width: 10ch;
    margin: 0;
    color: #fff;
    font-family: 'Bricolage Grotesque', var(--font-heading-family);
    font-style: normal;
    font-weight: 700;
    font-size: clamp(3.8rem, calc(5.848vw - .685rem), 6.8rem);
    line-height: 1.2;
    letter-spacing: normal;
    text-wrap: balance;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__text {
    max-width: 38rem;
    margin: 0 0 1.6rem;
    color: #fff;
    font-family: 'Bricolage Grotesque', var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 2.4rem;
    letter-spacing: normal;
    text-transform: uppercase;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__text > * {
    margin: 0;
    color: inherit;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button {
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 18.9rem;
    min-height: 5rem;
    margin-top: clamp(2.4rem, calc(1.163vw + 1.508rem), 3.2rem);
    padding: .4rem .9rem .4rem 2.4rem;
    color: #111;
    background: #fff;
    border: 1px solid #fff;
    border-radius: 999px;
    font-family: 'Bricolage Grotesque', var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 2.4rem;
    letter-spacing: normal;
    text-transform: capitalize;
    text-decoration: none;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    transition: color 750ms cubic-bezier(.4, 0, .2, 1), opacity 1500ms cubic-bezier(.16, 1, .3, 1), transform 1500ms cubic-bezier(.16, 1, .3, 1);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button::before {
    position: absolute;
    z-index: 0;
    inset: .1rem;
    content: '';
    background: #111;
    border-radius: inherit;
    clip-path: circle(1.5rem at calc(100% - 2.4rem) 50%);
    transition: clip-path 750ms cubic-bezier(.4, 0, .2, 1);
    will-change: clip-path;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button > span {
    position: relative;
    z-index: 1;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button:hover::before,
  #LuxuryHero-{{ section.id }} .luxury-hero__button:focus-visible::before {
    clip-path: circle(150% at calc(100% - 2.4rem) 50%);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button:hover,
  #LuxuryHero-{{ section.id }} .luxury-hero__button:focus-visible {
    color: #fff;
    background: #fff;
    transform: none;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 3rem;
    height: 3rem;
    color: #fff;
    position: relative;
    z-index: 1;
    background: transparent;
    border-radius: 50%;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button-icon svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    will-change: transform, opacity;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button:hover .luxury-hero__button-icon svg,
  #LuxuryHero-{{ section.id }} .luxury-hero__button:focus-visible .luxury-hero__button-icon svg {
    animation: luxury-hero-arrow-travel-{{ section.id }} 1.4s ease-in-out infinite;
  }

  @keyframes luxury-hero-arrow-travel-{{ section.id }} {
    0% {
      opacity: 0;
      transform: translateX(-.4rem);
    }
    25%,
    70% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateX(.4rem);
    }
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__controls {
    position: absolute;
    z-index: 3;
    right: max(5rem, calc((100vw - 144rem) / 2));
    bottom: clamp(4.2rem, 8vh, 8rem);
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__status {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    min-width: 3.2rem;
    color: #fff;
    font-family: 'Bricolage Grotesque', var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 2.4rem;
    letter-spacing: normal;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__current {
    font-size: inherit;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__progress {
    position: relative;
    display: block;
    width: 14rem;
    height: 2px;
    overflow: hidden;
    background: rgba(255, 255, 255, .42);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__progress-fill {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__navigation {
    display: flex;
    gap: .8rem;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__arrow {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    padding: 0;
    color: #fff;
    background: transparent;
    border: 0;
    border-radius: 50%;
    box-shadow: none;
    cursor: pointer;
    transition: transform 220ms ease, background-color 220ms ease;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__arrow:hover,
  #LuxuryHero-{{ section.id }} .luxury-hero__arrow:focus-visible {
    background: rgba(255, 255, 255, .12);
    transform: none;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__arrow svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  {% if request.page_type == 'index' %}
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .section-header {
      position: absolute !important;
      top: 0;
      right: 0;
      left: 0;
      z-index: 30;
      width: 100%;
      margin: 0;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header-wrapper {
      color: #fff;
      background: transparent !important;
      border: 0;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__heading-link .h2,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__menu-item,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__active-menu-item,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__icon {
      color: #fff;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__heading-logo {
      filter: brightness(0) invert(1);
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #LuxuryHero-{{ section.id }} {
      height: calc(100svh - 6.8rem);
      min-height: min(56rem, calc(100svh - 6.8rem));
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__content {
      display: flex;
      flex-direction: column;
      align-items: center;
      top: auto;
      right: 1.6rem;
      bottom: calc(10.8rem + env(safe-area-inset-bottom));
      left: 1.6rem;
      width: auto;
      text-align: center;
    }

    #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_left .luxury-hero__content,
    #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_center .luxury-hero__content,
    #LuxuryHero-{{ section.id }}.luxury-hero--content-bottom_right .luxury-hero__content {
      align-items: center;
      right: 1.6rem;
      left: 1.6rem;
      width: auto;
      transform: none;
      text-align: center;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__heading {
      max-width: 10ch;
      font-size: 3.8rem;
      line-height: 1.2;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__text {
      order: -1;
      max-width: 32rem;
      margin: 0 0 1.6rem;
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 2.4rem;
      letter-spacing: normal;
      text-transform: uppercase;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__button {
      width: 100%;
      min-height: 5rem;
      margin-top: 2.4rem;
      padding: .4rem .9rem .4rem 2.4rem;
      font-size: 1.5rem;
      text-align: left;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__button-icon {
      width: 3rem;
      height: 3rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__controls {
      right: 1.6rem;
      bottom: calc(6rem + env(safe-area-inset-bottom));
      left: 1.6rem;
      display: grid;
      grid-template-columns: auto minmax(6rem, 1fr) auto;
      gap: .8rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__status {
      min-width: auto;
      margin: 0;
      font-size: 1.5rem;
      line-height: 2.4rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__current {
      font-size: inherit;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__progress {
      width: 100%;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__navigation {
      gap: .8rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__arrow {
      width: 1.6rem;
      height: 1.6rem;
      color: #fff;
      background: transparent;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__arrow:hover,
    #LuxuryHero-{{ section.id }} .luxury-hero__arrow:focus-visible {
      background: rgba(255, 255, 255, .12);
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .section-header {
      position: relative !important;
      top: auto;
      background: #fff;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header-wrapper {
      color: #111;
      background: #fff !important;
      border-bottom: .1rem solid rgba(17, 17, 17, .14);
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header {
      box-sizing: border-box;
      height: 6.8rem;
      min-height: 6.8rem;
      padding-top: 0;
      padding-bottom: 0;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__heading-link .h2,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__menu-item,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__active-menu-item,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__icon {
      color: #111;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__heading-logo {
      filter: none;
    }
  }

  @media screen and (max-width: 749px) and (max-height: 600px) {
    #LuxuryHero-{{ section.id }} .luxury-hero__content {
      bottom: calc(10.4rem + env(safe-area-inset-bottom));
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__heading {
      font-size: 3.8rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__text {
      margin-bottom: 1.2rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__button {
      min-height: 5rem;
      margin-top: 1.6rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__button-icon {
      width: 3rem;
      height: 3rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__controls {
      bottom: calc(4rem + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LuxuryHero-{{ section.id }} .swiper-wrapper,
    #LuxuryHero-{{ section.id }} .luxury-hero__slide,
    #LuxuryHero-{{ section.id }} .luxury-hero__button,
    #LuxuryHero-{{ section.id }} .luxury-hero__button::before,
    #LuxuryHero-{{ section.id }} .luxury-hero__arrow {
      transition-duration: 0ms !important;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__button-icon svg {
      animation: none !important;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__media {
      transform: none !important;
      transition: none !important;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__content > .luxury-hero__text,
    #LuxuryHero-{{ section.id }} .luxury-hero__content > .luxury-hero__heading,
    #LuxuryHero-{{ section.id }} .luxury-hero__content > .luxury-hero__button {
      opacity: 1;
      transform: none;
      transition: none !important;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__progress-fill {
      transform: scaleX(1) !important;
    }
  }
{% endstyle %}

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    const loadSwiper = () => {
      if (window.Swiper) return Promise.resolve(window.Swiper);
      if (window.__luxuryHeroSwiperPromise) return window.__luxuryHeroSwiperPromise;

      window.__luxuryHeroSwiperPromise = new Promise((resolve, reject) => {
        const existingScript = document.querySelector('script[data-luxury-hero-swiper]');
        const script = existingScript || document.createElement('script');

        const handleLoad = () => resolve(window.Swiper);
        const handleError = () => reject(new Error('Unable to load Swiper'));

        script.addEventListener('load', handleLoad, { once: true });
        script.addEventListener('error', handleError, { once: true });

        if (!existingScript) {
          script.src = 'https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js';
          script.dataset.luxuryHeroSwiper = '';
          document.head.appendChild(script);
        }
      });

      return window.__luxuryHeroSwiperPromise;
    };

    const initialize = (root) => {
      if (!root || root.dataset.initialized === 'true') return;

      const sliderElement = root.querySelector('.luxury-hero__slider');
      const slides = Array.from(root.querySelectorAll('.luxury-hero__slide'));
      const current = root.querySelector('.luxury-hero__current');
      const progress = root.querySelector('.luxury-hero__progress-fill');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const autoplayEnabled = root.dataset.autoplay === 'true' && slides.length > 1 && !prefersReducedMotion;
      const autoplayDelay = Number(root.dataset.autoplayInterval) || 6000;
      const transitionDuration = prefersReducedMotion ? 0 : Number(root.dataset.transitionDuration) || 1200;
      let interactionPaused = false;

      if (!sliderElement || !window.Swiper) return;

      root.dataset.initialized = 'true';

      const updateCurrent = (swiper) => {
        if (current) current.textContent = String(swiper.realIndex + 1);
      };

      const pause = (swiper) => {
        if (!autoplayEnabled || !swiper.autoplay || !swiper.autoplay.running) return;
        interactionPaused = true;
        swiper.autoplay.pause();
      };

      const resume = (swiper) => {
        if (
          !autoplayEnabled ||
          !interactionPaused ||
          root.matches(':hover') ||
          root.contains(document.activeElement) ||
          document.hidden
        ) return;

        interactionPaused = false;
        swiper.autoplay.resume();
      };

      const swiper = new window.Swiper(sliderElement, {
        direction: 'horizontal',
        effect: 'fade',
        fadeEffect: {
          crossFade: true
        },
        speed: transitionDuration,
        loop: slides.length > 1,
        allowTouchMove: slides.length > 1,
        watchSlidesProgress: true,
        navigation: {
          prevEl: root.querySelector('.luxury-hero__previous'),
          nextEl: root.querySelector('.luxury-hero__next')
        },
        autoplay: autoplayEnabled
          ? {
              delay: autoplayDelay,
              disableOnInteraction: false,
              pauseOnMouseEnter: true,
              waitForTransition: true
            }
          : false,
        a11y: {
          enabled: true,
          prevSlideMessage: 'Previous slide',
          nextSlideMessage: 'Next slide'
        },
        on: {
          init(instance) {
            updateCurrent(instance);
            if (progress && !autoplayEnabled) progress.style.transform = 'scaleX(1)';
          },
          realIndexChange(instance) {
            updateCurrent(instance);
          },
          autoplayTimeLeft(instance, timeLeft, percentage) {
            if (progress) {
              const elapsed = Math.max(0, Math.min(1, 1 - percentage));
              progress.style.transform = `scaleX(${elapsed})`;
            }
          }
        }
      });

      root.addEventListener('mouseenter', () => pause(swiper));
      root.addEventListener('mouseleave', () => resume(swiper));
      root.addEventListener('focusin', () => pause(swiper));
      root.addEventListener('focusout', () => window.setTimeout(() => resume(swiper), 0));

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          pause(swiper);
        } else {
          resume(swiper);
        }
      });

      document.addEventListener('shopify:block:select', (event) => {
        if (!root.contains(event.target)) return;
        const selectedSlide = event.target.closest('.luxury-hero__slide');
        const selectedIndex = slides.findIndex((slide) => slide.dataset.blockId === selectedSlide?.dataset.blockId);
        if (selectedIndex < 0) return;

        pause(swiper);
        if (swiper.params.loop) {
          swiper.slideToLoop(selectedIndex, 0);
        } else {
          swiper.slideTo(selectedIndex, 0);
        }
      });

      document.addEventListener('shopify:block:deselect', () => resume(swiper));
    };

    const boot = (scope = document) => {
      const root = scope.querySelector?.(`#LuxuryHero-${sectionId}`);
      if (!root) return;
      loadSwiper().then(() => initialize(root)).catch(() => {
        root.dataset.initialized = 'error';
      });
    };

    boot();

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === sectionId) boot(event.target);
    });
  })();
</script>

