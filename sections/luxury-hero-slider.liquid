{% liquid
  assign slide_count = section.blocks.size
  assign autoplay_interval = section.settings.autoplay_interval | times: 1000
%}

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
>

<section
  id="LuxuryHero-{{ section.id }}"
  class="luxury-hero"
  data-luxury-hero
  data-section-id="{{ section.id }}"
  data-slide-count="{{ slide_count }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-autoplay-interval="{{ autoplay_interval }}"
  data-transition-duration="{{ section.settings.transition_duration }}"
  style="
    --luxury-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --luxury-hero-transition: {{ section.settings.transition_duration }}ms;
  "
>
  <div class="luxury-hero__slider swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div
          class="luxury-hero__slide swiper-slide"
          data-block-id="{{ block.id }}"
          role="group"
          aria-label="Slide {{ forloop.index }} of {{ forloop.length }}"
          {{ block.shopify_attributes }}
        >
          <div class="luxury-hero__media">
            {% if block.settings.image != blank %}
              {% if forloop.first %}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    widths: '750, 1100, 1500, 2000, 2500, 3000, 3840',
                    sizes: '100vw',
                    class: 'luxury-hero__image',
                    loading: 'eager',
                    fetchpriority: 'high'
                }}
              {% else %}
                {{
                  block.settings.image
                  | image_url: width: 3840
                  | image_tag:
                    widths: '750, 1100, 1500, 2000, 2500, 3000, 3840',
                    sizes: '100vw',
                    class: 'luxury-hero__image',
                    loading: 'lazy'
                }}
              {% endif %}
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'luxury-hero__image luxury-hero__placeholder' }}
            {% endif %}
          </div>

          <div class="luxury-hero__shade"></div>

          <div class="luxury-hero__content">
            {% if block.settings.heading != blank %}
              <h2 class="luxury-hero__heading">{{ block.settings.heading }}</h2>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="luxury-hero__text rte">{{ block.settings.text }}</div>
            {% endif %}

            {% if block.settings.button_label != blank %}
              {% liquid
                assign cta_url = block.settings.button_link
                if cta_url == blank
                  assign cta_url = routes.all_products_collection_url | default: '/collections/all'
                endif
              %}
              <a class="luxury-hero__button" href="{{ cta_url }}">
                <span>{{ block.settings.button_label | escape }}</span>
                <span class="luxury-hero__button-icon" aria-hidden="true">↗</span>
              </a>
            {% endif %}
          </div>
        </div>
      {% else %}
        <div class="luxury-hero__slide swiper-slide luxury-hero__slide--empty">
          <div class="luxury-hero__media">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'luxury-hero__image luxury-hero__placeholder' }}
          </div>
          <div class="luxury-hero__shade"></div>
          <div class="luxury-hero__content">
            <h2 class="luxury-hero__heading">{{ 'sections.slideshow.load_slide' | t }}</h2>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>

  {% if slide_count > 1 %}
    <div class="luxury-hero__controls" aria-label="Slideshow controls">
      <div class="luxury-hero__status">
        <span class="luxury-hero__current" aria-live="polite">1</span>
        <span aria-hidden="true">/</span>
        <span class="luxury-hero__total">{{ slide_count }}</span>
      </div>

      <span class="luxury-hero__progress" aria-hidden="true">
        <span class="luxury-hero__progress-fill"></span>
      </span>

      <div class="luxury-hero__navigation">
        <button class="luxury-hero__arrow luxury-hero__previous" type="button" aria-label="Previous slide">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="M12.75 4.75 7.5 10l5.25 5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </button>
        <button class="luxury-hero__arrow luxury-hero__next" type="button" aria-label="Next slide">
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path d="m7.25 4.75 5.25 5.25-5.25 5.25" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
    </div>
  {% endif %}
</section>

{% style %}
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
    max-width: none;
  }

  #LuxuryHero-{{ section.id }} {
    position: relative;
    left: 50%;
    width: 100vw;
    height: 100vh;
    height: 100svh;
    min-height: 38rem;
    margin-left: -50vw;
    overflow: hidden;
    color: #fff;
    background: #1d2118;
    isolation: isolate;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slider,
  #LuxuryHero-{{ section.id }} .swiper-wrapper,
  #LuxuryHero-{{ section.id }} .luxury-hero__slide {
    width: 100%;
    height: 100%;
  }

  #LuxuryHero-{{ section.id }} .swiper-wrapper {
    transition-timing-function: cubic-bezier(.77, 0, .18, 1) !important;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slide {
    position: relative;
    overflow: hidden;
    opacity: 0;
    transition: opacity var(--luxury-hero-transition) cubic-bezier(.77, 0, .18, 1);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__slide.swiper-slide-active {
    opacity: 1;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__media,
  #LuxuryHero-{{ section.id }} .luxury-hero__shade {
    position: absolute;
    inset: 0;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__media {
    background: #9baa83;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__placeholder {
    background: #9baa83;
    fill: rgba(255, 255, 255, .35);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__shade {
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(0, 0, 0, .18) 0%, rgba(0, 0, 0, .02) 42%, rgba(0, 0, 0, .48) 100%),
      rgba(0, 0, 0, var(--luxury-hero-overlay));
    pointer-events: none;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__content {
    position: absolute;
    z-index: 2;
    left: clamp(2rem, 5vw, 7.2rem);
    bottom: clamp(4.2rem, 8vh, 8rem);
    width: min(46rem, calc(100vw - 4rem));
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__heading {
    max-width: 10ch;
    margin: 0;
    color: #fff;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(4.6rem, 7vw, 10rem);
    font-weight: 400;
    line-height: .9;
    letter-spacing: -.045em;
    text-wrap: balance;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__text {
    max-width: 38rem;
    margin-top: 1.8rem;
    color: rgba(255, 255, 255, .9);
    font-size: clamp(1.4rem, 1.15vw, 1.7rem);
    line-height: 1.5;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__text > * {
    margin: 0;
    color: inherit;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.4rem;
    min-width: 18rem;
    min-height: 5.4rem;
    margin-top: 2.6rem;
    padding: 1.2rem 1.2rem 1.2rem 2.4rem;
    color: #111;
    background: #fff;
    border-radius: 999px;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: transform 220ms ease, background-color 220ms ease;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button:hover,
  #LuxuryHero-{{ section.id }} .luxury-hero__button:focus-visible {
    color: #111;
    background: #f2f2f2;
    transform: translateY(-2px);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__button-icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    color: #fff;
    background: #111;
    border-radius: 50%;
    font-size: 1.5rem;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__controls {
    position: absolute;
    z-index: 3;
    right: clamp(2rem, 5vw, 7.2rem);
    bottom: clamp(4.2rem, 8vh, 8rem);
    display: flex;
    align-items: center;
    gap: 1.8rem;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__status {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    min-width: 5.8rem;
    color: #fff;
    font-size: 1.8rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__current {
    font-size: 2.4rem;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__progress {
    position: relative;
    display: block;
    width: 4.4rem;
    height: 1px;
    overflow: hidden;
    background: rgba(255, 255, 255, .42);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__progress-fill {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__navigation {
    display: flex;
    gap: .8rem;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__arrow {
    display: grid;
    place-items: center;
    width: 4.8rem;
    height: 4.8rem;
    padding: 0;
    color: #111;
    background: #fff;
    border: 0;
    border-radius: 50%;
    box-shadow: none;
    cursor: pointer;
    transition: transform 220ms ease, background-color 220ms ease;
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__arrow:hover,
  #LuxuryHero-{{ section.id }} .luxury-hero__arrow:focus-visible {
    background: #f2f2f2;
    transform: scale(1.06);
  }

  #LuxuryHero-{{ section.id }} .luxury-hero__arrow svg {
    width: 2rem;
    height: 2rem;
  }

  {% if request.page_type == 'index' %}
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .section-header {
      position: absolute !important;
      top: 0;
      right: 0;
      left: 0;
      z-index: 30;
      width: 100%;
      margin: 0;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header-wrapper {
      color: #fff;
      background: transparent !important;
      border: 0;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__heading-link .h2,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__menu-item,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__active-menu-item,
    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__icon {
      color: #fff;
    }

    body:has(#MainContent > .shopify-section:first-child #LuxuryHero-{{ section.id }}) .header__heading-logo {
      filter: brightness(0) invert(1);
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    #LuxuryHero-{{ section.id }} {
      min-height: 56rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__content {
      right: 2rem;
      bottom: calc(10.8rem + env(safe-area-inset-bottom));
      left: 2rem;
      width: auto;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__heading {
      max-width: 9ch;
      font-size: clamp(4.2rem, 15vw, 6.8rem);
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__text {
      max-width: 30rem;
      margin-top: 1.2rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__button {
      min-height: 5rem;
      margin-top: 1.8rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__controls {
      right: 2rem;
      bottom: calc(2.4rem + env(safe-area-inset-bottom));
      left: 2rem;
      justify-content: flex-end;
      gap: 1.2rem;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__status {
      margin-right: auto;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__arrow {
      width: 4.4rem;
      height: 4.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #LuxuryHero-{{ section.id }} .swiper-wrapper,
    #LuxuryHero-{{ section.id }} .luxury-hero__slide,
    #LuxuryHero-{{ section.id }} .luxury-hero__button,
    #LuxuryHero-{{ section.id }} .luxury-hero__arrow {
      transition-duration: 0ms !important;
    }

    #LuxuryHero-{{ section.id }} .luxury-hero__progress-fill {
      transform: scaleX(1) !important;
    }
  }
{% endstyle %}

<script>
  (() => {
    const sectionId = {{ section.id | json }};

    const loadSwiper = () => {
      if (window.Swiper) return Promise.resolve(window.Swiper);
      if (window.__luxuryHeroSwiperPromise) return window.__luxuryHeroSwiperPromise;

      window.__luxuryHeroSwiperPromise = new Promise((resolve, reject) => {
        const existingScript = document.querySelector('script[data-luxury-hero-swiper]');
        const script = existingScript || document.createElement('script');

        const handleLoad = () => resolve(window.Swiper);
        const handleError = () => reject(new Error('Unable to load Swiper'));

        script.addEventListener('load', handleLoad, { once: true });
        script.addEventListener('error', handleError, { once: true });

        if (!existingScript) {
          script.src = 'https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js';
          script.dataset.luxuryHeroSwiper = '';
          document.head.appendChild(script);
        }
      });

      return window.__luxuryHeroSwiperPromise;
    };

    const initialize = (root) => {
      if (!root || root.dataset.initialized === 'true') return;

      const sliderElement = root.querySelector('.luxury-hero__slider');
      const slides = Array.from(root.querySelectorAll('.luxury-hero__slide'));
      const current = root.querySelector('.luxury-hero__current');
      const progress = root.querySelector('.luxury-hero__progress-fill');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const autoplayEnabled = root.dataset.autoplay === 'true' && slides.length > 1 && !prefersReducedMotion;
      const autoplayDelay = Number(root.dataset.autoplayInterval) || 6000;
      const transitionDuration = prefersReducedMotion ? 0 : Number(root.dataset.transitionDuration) || 1200;
      let interactionPaused = false;

      if (!sliderElement || !window.Swiper) return;

      root.dataset.initialized = 'true';

      const updateCurrent = (swiper) => {
        if (current) current.textContent = String(swiper.realIndex + 1);
      };

      const pause = (swiper) => {
        if (!autoplayEnabled || !swiper.autoplay || !swiper.autoplay.running) return;
        interactionPaused = true;
        swiper.autoplay.pause();
      };

      const resume = (swiper) => {
        if (
          !autoplayEnabled ||
          !interactionPaused ||
          root.matches(':hover') ||
          root.contains(document.activeElement) ||
          document.hidden
        ) return;

        interactionPaused = false;
        swiper.autoplay.resume();
      };

      const swiper = new window.Swiper(sliderElement, {
        direction: 'vertical',
        speed: transitionDuration,
        loop: slides.length > 1,
        allowTouchMove: slides.length > 1,
        watchSlidesProgress: true,
        navigation: {
          prevEl: root.querySelector('.luxury-hero__previous'),
          nextEl: root.querySelector('.luxury-hero__next')
        },
        autoplay: autoplayEnabled
          ? {
              delay: autoplayDelay,
              disableOnInteraction: false,
              pauseOnMouseEnter: true,
              waitForTransition: true
            }
          : false,
        a11y: {
          enabled: true,
          prevSlideMessage: 'Previous slide',
          nextSlideMessage: 'Next slide'
        },
        on: {
          init(instance) {
            updateCurrent(instance);
            if (progress && !autoplayEnabled) progress.style.transform = 'scaleX(1)';
          },
          realIndexChange(instance) {
            updateCurrent(instance);
          },
          autoplayTimeLeft(instance, timeLeft, percentage) {
            if (progress) {
              const elapsed = Math.max(0, Math.min(1, 1 - percentage));
              progress.style.transform = `scaleX(${elapsed})`;
            }
          }
        }
      });

      root.addEventListener('mouseenter', () => pause(swiper));
      root.addEventListener('mouseleave', () => resume(swiper));
      root.addEventListener('focusin', () => pause(swiper));
      root.addEventListener('focusout', () => window.setTimeout(() => resume(swiper), 0));

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          pause(swiper);
        } else {
          resume(swiper);
        }
      });

      document.addEventListener('shopify:block:select', (event) => {
        if (!root.contains(event.target)) return;
        const selectedSlide = event.target.closest('.luxury-hero__slide');
        const selectedIndex = slides.findIndex((slide) => slide.dataset.blockId === selectedSlide?.dataset.blockId);
        if (selectedIndex < 0) return;

        pause(swiper);
        if (swiper.params.loop) {
          swiper.slideToLoop(selectedIndex, 0);
        } else {
          swiper.slideTo(selectedIndex, 0);
        }
      });

      document.addEventListener('shopify:block:deselect', () => resume(swiper));
    };

    const boot = (scope = document) => {
      const root = scope.querySelector?.(`#LuxuryHero-${sectionId}`);
      if (!root) return;
      loadSwiper().then(() => initialize(root)).catch(() => {
        root.dataset.initialized = 'error';
      });
    };

    boot();

    document.addEventListener('shopify:section:load', (event) => {
      if (event.detail.sectionId === sectionId) boot(event.target);
    });
  })();
</script>

{% schema %}
{
  "name": "Luxury hero slider",
  "tag": "section",
  "class": "section-luxury-hero-slider",
  "max_blocks": 8,
  "settings": [
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 6
    },
    {
      "type": "range",
      "id": "transition_duration",
      "min": 600,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "label": "Transition duration",
      "default": 1200
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Softness in Comfort"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Discover elevated essentials created for beautifully simple everyday moments.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop collection"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury hero slider",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
