<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
  <link rel="stylesheet" href="{{ 'component-loading-overlay.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}
{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript>{{ 'component-mega-menu.css' | asset_url | stylesheet_tag }}</noscript>
{%- endif -%}
{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  {{ 'component-localization-form.css' | asset_url | stylesheet_tag: preload: true }}
{%- endif -%}

{%- if settings.cart_type == "drawer" -%}
  {{ 'component-cart-drawer.css' | asset_url | stylesheet_tag }}
  {{ 'component-cart.css' | asset_url | stylesheet_tag }}
  {{ 'component-totals.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-discounts.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<noscript>{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-search.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-menu-drawer.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-cart-notification.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-cart-items.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign mobile_drawer_font = section.settings.mobile_drawer_font
  assign mobile_drawer_font_medium = mobile_drawer_font | font_modify: 'weight', '500'
  assign mobile_drawer_font_semibold = mobile_drawer_font | font_modify: 'weight', '600'
  assign mobile_drawer_font_bold = mobile_drawer_font | font_modify: 'weight', '700'
-%}
{%- style -%}
  {{ mobile_drawer_font | font_face: font_display: 'swap' }}
  {{ mobile_drawer_font_medium | font_face: font_display: 'swap' }}
  {{ mobile_drawer_font_semibold | font_face: font_display: 'swap' }}
  {{ mobile_drawer_font_bold | font_face: font_display: 'swap' }}
{%- endstyle -%}

<style>
  header-drawer {
    justify-self: start;
    margin-left: -1.2rem;
  }


  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 991px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }

  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
  }

  summary.list-menu__item {
    padding-right: 2.7rem;
  }

  .list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));
  }

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  .header__heading-logo--transparent {
    display: none;
  }

  sticky-header[data-responsive-header='v2'] .header {
    width: 100%;
    max-width: none;
    min-height: 7.2rem;
    padding-right: clamp(2.4rem, 4vw, 6.4rem);
    padding-left: clamp(2.4rem, 4vw, 6.4rem);
  }

  sticky-header[data-responsive-header='v2'] .header__inline-menu .list-menu--inline {
    column-gap: clamp(0.4rem, 1vw, 1.8rem);
  }

  sticky-header[data-responsive-header='v2'] .header__menu-item {
    font-size: 1.4rem;
    letter-spacing: 0;
  }

  sticky-header[data-responsive-header='v2'] .header__icons {
    gap: 0.4rem;
  }

  .header__menu-label a {
    color: inherit;
    text-decoration: inherit;
  }

  .header__menu-label a:focus-visible {
    outline: 0.2rem solid currentColor;
    outline-offset: 0.3rem;
  }

  .menu-drawer__menu-item--has-children {
    position: relative;
    display: flex;
    align-items: center;
    list-style: none;
  }

  .menu-drawer__menu-item--has-children::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__menu-link {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 4.8rem;
    color: inherit;
    text-decoration: none;
  }

  .menu-drawer__submenu-toggle {
    display: grid;
    flex: 0 0 4.4rem;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    place-items: center;
    color: inherit;
    cursor: pointer;
    list-style: none;
  }

  .menu-drawer__submenu-toggle::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__submenu-toggle .icon-arrow {
    position: static;
    width: 1.6rem;
    height: 1.6rem;
    transform: none;
  }

  .menu-drawer__submenu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5.6rem;
    padding: 0 1.2rem 0 1.6rem;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.1);
  }

  .menu-drawer__submenu-header .menu-drawer__close-button {
    flex: 1 1 auto;
    width: auto;
    margin: 0;
    padding: 1.2rem 0;
  }

  .menu-drawer__submenu-close-all {
    display: grid;
    flex: 0 0 4.4rem;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    place-items: center;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .menu-drawer__submenu-close-all .icon {
    width: 1.8rem;
    height: 1.8rem;
  }

  @media screen and (min-width: 991px) {
    header-drawer {
      display: none;
    }

    .header__inline-menu {
      display: block;
    }

    /*
      One shared white canvas sits behind the header and the open mega content.
      Keeping the canvas inside sticky-header prevents the Theme Editor iframe
      from separating the header background from the panel background.
    */
    sticky-header[data-responsive-header='v2'] {
      position: relative;
      z-index: 4;
      isolation: isolate;
    }

    sticky-header[data-responsive-header='v2']::before {
      position: fixed;
      top: var(--header-mega-canvas-top, 0px);
      right: 0;
      left: 0;
      z-index: 0;
      width: 100vw;
      height: 0;
      pointer-events: none;
      background: #fff;
      content: '';
      transform: translateZ(0);
      transition: height 300ms cubic-bezier(.6, .14, 0, 1);
      will-change: height;
    }

    .section-header.mega-menu-open sticky-header[data-responsive-header='v2']::before {
      height: var(--header-mega-canvas-height, 0px);
    }

    .section-header.mega-menu-closing sticky-header[data-responsive-header='v2']::before {
      height: 0;
    }

    sticky-header[data-responsive-header='v2'] > .header {
      position: relative;
      z-index: 1;
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav {
      align-self: stretch;
      height: 100%;
      font-family: {{ mobile_drawer_font.family }}, {{ mobile_drawer_font.fallback_families }};
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav > .list-menu--inline {
      align-items: stretch;
      height: 100%;
      column-gap: clamp(1.8rem, 2.1vw, 4.2rem);
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav > .list-menu--inline > li,
    sticky-header[data-responsive-header='v2'] .helix-desktop-nav header-menu,
    sticky-header[data-responsive-header='v2'] .helix-desktop-nav details {
      display: flex;
      align-items: stretch;
      height: 100%;
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav details > summary,
    sticky-header[data-responsive-header='v2'] .helix-desktop-nav__link {
      position: relative;
      display: flex;
      align-items: center;
      min-height: 7.2rem;
      padding: 0;
      color: inherit;
      font-size: clamp(1.35rem, 0.84vw, 1.6rem);
      font-weight: 500;
      line-height: 1;
      text-decoration: none;
      cursor: pointer;
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav details > summary::-webkit-details-marker {
      display: none;
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav details > summary::after,
    sticky-header[data-responsive-header='v2'] .helix-desktop-nav__link::after {
      position: absolute;
      right: 0;
      bottom: 1.5rem;
      left: 0;
      height: 0.1rem;
      background: currentColor;
      content: '';
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 300ms cubic-bezier(.6, .14, 0, 1);
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav details[open] > summary::after,
    sticky-header[data-responsive-header='v2'] .helix-desktop-nav__link:hover::after,
    sticky-header[data-responsive-header='v2'] .helix-desktop-nav__link:focus-visible::after {
      transform: scaleX(1);
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav .header__menu-label a {
      color: inherit;
      font: inherit;
      text-decoration: none;
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav .icon-caret {
      position: static;
      width: 0.9rem;
      height: 0.6rem;
      margin-left: 0.8rem;
      transition: transform 260ms cubic-bezier(.22, 1, .36, 1);
    }

    sticky-header[data-responsive-header='v2'] .helix-desktop-nav details[open] > summary .icon-caret {
      transform: rotate(180deg);
    }

    .helix-mega-menu__content {
      position: fixed;
      top: var(--header-mega-top, 7.2rem);
      right: 0;
      left: 0;
      z-index: 4;
      width: 100vw;
      height: 0;
      max-height: calc(100svh - var(--header-mega-top, 7.2rem) - 2rem);
      margin: 0;
      padding: 0;
      overflow: hidden;
      color: #202326;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      pointer-events: none;
      visibility: hidden;
      transition:
        height 300ms cubic-bezier(.6, .14, 0, 1),
        visibility 0s linear 300ms;
    }

    .helix-mega-menu[open] > .helix-mega-menu__content {
      height: var(--header-mega-height, 0px);
      pointer-events: auto;
      visibility: visible;
      transition:
        height 300ms cubic-bezier(.6, .14, 0, 1),
        visibility 0s linear 0s;
    }

    .helix-mega-menu.is-closing > .helix-mega-menu__content {
      height: 0;
      pointer-events: none;
    }

    .helix-mega-menu__inner {
      display: grid;
      grid-template-columns: minmax(44rem, 0.9fr) minmax(52rem, 1.35fr);
      gap: clamp(4rem, 6vw, 12rem);
      min-height: clamp(43rem, 48vh, 56rem);
      padding: clamp(4rem, 5vw, 7.2rem) clamp(4rem, 4.2vw, 8rem) clamp(4.8rem, 5vw, 7.2rem);
    }

    .helix-mega-menu__column,
    .helix-mega-promos,
    .helix-mega-products {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0);
    }

    .helix-mega-menu[open]:not(.is-closing) .helix-mega-menu__column,
    .helix-mega-menu[open]:not(.is-closing) .helix-mega-promos,
    .helix-mega-menu[open]:not(.is-closing) .helix-mega-products {
      animation: helix-mega-item-in 440ms ease forwards;
    }

    .helix-mega-menu[open]:not(.is-closing) .helix-mega-menu__column:nth-child(1) {
      animation-delay: 140ms;
    }

    .helix-mega-menu[open]:not(.is-closing) .helix-mega-menu__column:nth-child(2) {
      animation-delay: 190ms;
    }

    .helix-mega-menu[open]:not(.is-closing) .helix-mega-menu__column:nth-child(3),
    .helix-mega-menu[open]:not(.is-closing) .helix-mega-promos,
    .helix-mega-menu[open]:not(.is-closing) .helix-mega-products {
      animation-delay: 240ms;
    }

    @keyframes helix-mega-item-in {
      from {
        opacity: 0;
        transform: translate3d(0, 1.5rem, 0);
      }

      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .helix-mega-menu__inner:has(.helix-mega-menu__columns:only-child) {
      grid-template-columns: minmax(44rem, 68rem);
    }

    .helix-mega-menu__columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(3.2rem, 4vw, 8rem);
      align-content: start;
    }

    .helix-mega-menu__column-heading {
      margin: 0 0 2rem;
      color: #202326;
      font-size: clamp(1.45rem, 0.95vw, 1.8rem);
      font-weight: 600;
      line-height: 1.25;
    }

    .helix-mega-menu__links {
      display: grid;
      gap: 1.5rem;
      margin: 0;
      padding: 0;
    }

    .helix-mega-menu__link {
      display: inline-flex;
      width: fit-content;
      color: #313438;
      font-size: clamp(1.35rem, 0.88vw, 1.65rem);
      font-weight: 400;
      line-height: 1.35;
      text-decoration: none;
      transition: color 160ms ease, transform 200ms ease;
    }

    .helix-mega-menu__column--strong .helix-mega-menu__link {
      font-weight: 650;
    }

    .helix-mega-menu__link:hover,
    .helix-mega-menu__link:focus-visible {
      color: #000;
      text-decoration: underline;
      text-underline-offset: 0.35rem;
      transform: translateX(0.2rem);
    }

    .helix-mega-promos {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.6rem, 1.4vw, 2.8rem);
      align-content: start;
    }

    .helix-mega-promo__image-link {
      display: block;
      height: clamp(20rem, 24vw, 31rem);
      overflow: hidden;
      background: #f3f4f4;
      border-radius: 1.8rem;
    }

    .helix-mega-promo__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 600ms cubic-bezier(.22, 1, .36, 1);
    }

    .helix-mega-promo:hover .helix-mega-promo__image {
      transform: scale(1.035);
    }

    .helix-mega-promo h3 {
      margin: 1.6rem 0 1rem;
      font-size: clamp(1.55rem, 1vw, 1.9rem);
      font-weight: 650;
      line-height: 1.25;
    }

    .helix-mega-promo h3 a,
    .helix-mega-promo__cta {
      color: #202326;
      text-decoration: none;
    }

    .helix-mega-promo__cta {
      display: inline-flex;
      gap: 1.1rem;
      align-items: center;
      font-size: clamp(1.35rem, 0.85vw, 1.6rem);
    }

    .helix-mega-promo__cta span {
      transition: transform 180ms ease;
    }

    .helix-mega-promo__cta:hover span {
      transform: translate(0.2rem, -0.2rem);
    }

    .helix-mega-products {
      min-width: 0;
    }

    .helix-mega-products__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2.4rem;
    }

    .helix-mega-products__header h3 {
      margin: 0;
      color: #202326;
      font-size: clamp(1.7rem, 1.1vw, 2.1rem);
      font-weight: 650;
    }

    .helix-mega-products__arrows {
      display: flex;
      gap: 0.6rem;
    }

    .helix-mega-products__arrows button {
      display: grid;
      width: 3.2rem;
      height: 3.2rem;
      padding: 0;
      place-items: center;
      color: #202326;
      background: transparent;
      border: 0;
      border-radius: 50%;
      cursor: pointer;
    }

    .helix-mega-products__arrows svg {
      width: 2rem;
      height: 2rem;
    }

    .helix-mega-products__track {
      display: grid;
      grid-auto-columns: minmax(21rem, 1fr);
      grid-auto-flow: column;
      gap: 1.6rem;
      padding-bottom: 0.8rem;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: none;
      scroll-snap-type: x mandatory;
    }

    .helix-mega-products__track::-webkit-scrollbar {
      display: none;
    }

    .helix-mega-product {
      min-width: 0;
      scroll-snap-align: start;
    }

    .helix-mega-product__image-link {
      position: relative;
      display: grid;
      height: clamp(20rem, 21vw, 30rem);
      padding: 1.6rem;
      place-items: center;
      overflow: hidden;
      background: #f6f6f6;
      border-radius: 1.8rem;
    }

    .helix-mega-product__image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: transform 450ms cubic-bezier(.22, 1, .36, 1);
    }

    .helix-mega-product:hover .helix-mega-product__image {
      transform: scale(1.035);
    }

    .helix-mega-product__badge {
      position: absolute;
      top: 1.4rem;
      left: 1.4rem;
      z-index: 1;
      padding: 0.5rem 1rem;
      color: #fff;
      font-size: 1.2rem;
      line-height: 1;
      background: #ff8589;
      border-radius: 99rem;
    }

    .helix-mega-product__title {
      display: block;
      margin-top: 1.3rem;
      overflow: hidden;
      color: #3d4043;
      font-size: clamp(1.3rem, 0.8vw, 1.55rem);
      text-decoration: none;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .helix-mega-product__price {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
      margin-top: 0.5rem;
      color: #ff8589;
      font-size: 1.35rem;
    }

    .helix-mega-product__price s {
      color: #9a9da0;
    }

    .header-mega-shell {
      display: none;
    }

    .section-header {
      isolation: isolate;
    }

    .header-mega-overlay {
      position: fixed;
      top: var(--header-mega-top, 7.2rem);
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 3;
      display: block;
      width: 100%;
      padding: 0;
      background: rgba(18, 24, 27, 0.62);
      border: 0;
      cursor: default;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      backdrop-filter: blur(0.8rem) saturate(0.78);
      -webkit-backdrop-filter: blur(0.8rem) saturate(0.78);
      transition: opacity 260ms ease, visibility 260ms ease;
    }

    .section-header.mega-menu-open .header-mega-overlay {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
    }

    .section-header.mega-menu-open .header-wrapper,
    .section-header.mega-menu-closing .header-wrapper {
      color: #202326 !important;
      background: transparent !important;
      border-color: transparent !important;
      box-shadow: none !important;
    }

    .section-header.mega-menu-open .header-wrapper .header__menu-item,
    .section-header.mega-menu-open .header-wrapper .header__icon,
    .section-header.mega-menu-open .header-wrapper .header__heading-link,
    .section-header.mega-menu-open .header-wrapper .header__heading-link .h2,
    .section-header.mega-menu-open .header-wrapper .localization-form__select,
    .section-header.mega-menu-closing .header-wrapper .header__menu-item,
    .section-header.mega-menu-closing .header-wrapper .header__icon,
    .section-header.mega-menu-closing .header-wrapper .header__heading-link,
    .section-header.mega-menu-closing .header-wrapper .header__heading-link .h2,
    .section-header.mega-menu-closing .header-wrapper .localization-form__select {
      color: #202326 !important;
    }

    .section-header.mega-menu-open .header__heading-logo--transparent,
    .section-header.mega-menu-closing .header__heading-logo--transparent {
      display: none !important;
    }

    .section-header.mega-menu-open .header__heading-logo--default,
    .section-header.mega-menu-closing .header__heading-logo--default {
      display: inline-block !important;
      filter: none !important;
    }
  }

  @media screen and (max-width: 990px) {
    sticky-header[data-responsive-header='v2'] .header {
      min-height: 5.6rem;
      padding: 0 1.2rem;
    }

    .header__inline-menu {
      display: none;
    }

    .header__icon--account {
      display: none !important;
    }

    .header__icon,
    .header__icon--cart .icon {
      min-width: 4.4rem;
      min-height: 4.4rem;
    }

    .section-header.menu-open {
      z-index: 100;
    }

    .menu-drawer-container {
      --mobile-drawer-edge: clamp(0.8rem, 2vw, 1.4rem);
    }

    .menu-drawer__backdrop {
      position: fixed;
      inset: 0;
      z-index: 998;
      display: block;
      width: 100%;
      height: 100%;
      padding: 0;
      border: 0;
      background: rgba(18, 21, 23, 0.5);
      backdrop-filter: blur(0.65rem) saturate(0.82);
      cursor: default;
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: opacity var(--header-drawer-duration) ease, visibility var(--header-drawer-duration) ease;
    }

    header-drawer > details.menu-drawer-container[open].menu-opening > .menu-drawer__backdrop {
      display: block;
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      background: rgba(18, 21, 23, 0.5);
      backdrop-filter: blur(0.65rem) saturate(0.82);
      -webkit-backdrop-filter: blur(0.65rem) saturate(0.82);
    }

    /* Do not leave a backdrop filter attached while the drawer is closing.
