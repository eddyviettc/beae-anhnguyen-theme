    .section-header.header--hero.header--scrolled .header-wrapper .header__active-menu-item,
    .section-header.header--hero.header--scrolled .header-wrapper .header__icon,
    .section-header.header--hero.header--scrolled .header-wrapper .header__heading-link,
    .section-header.header--hero.header--scrolled .header-wrapper .header__heading-link .h2,
    .section-header.header--hero.header--scrolled .header-wrapper .localization-form__select,
    .section-header.header--sticky .header-wrapper .header__menu-item,
    .section-header.header--sticky .header-wrapper .header__active-menu-item,
    .section-header.header--sticky .header-wrapper .header__icon,
    .section-header.header--sticky .header-wrapper .header__heading-link,
    .section-header.header--sticky .header-wrapper .header__heading-link .h2,
    .section-header.header--sticky .header-wrapper .localization-form__select {
      color: var(--header-sticky-text);
    }

    .section-header.header--mobile-hidden {
      transform: translateY(calc(-100% - 0.8rem));
      pointer-events: none;
      transition-delay: 140ms;
    }

    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default:not(:only-child),
    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default {
      {% if section.settings.transparent_logo != blank %}display: none;{% endif %}
    }

    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--transparent {
      {% if section.settings.transparent_logo != blank %}display: inline-block;{% endif %}
    }
  }

  {% if section.settings.transparent_color_scheme == 'light' and section.settings.transparent_logo == blank %}
    .section-header.header--hero:not(.header--scrolled) .header__heading-logo--default {
      filter: brightness(0) invert(1);
    }
  {% endif %}

  @media (prefers-reduced-motion: reduce) {
    .section-header.header--mobile-hidden {
      transition-delay: 0ms !important;
    }
  }
{%- endstyle -%}

<script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>
{%- if settings.cart_type == "drawer" -%}
  <script src="{{ 'cart-drawer.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  <script src="{{ 'localization-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<svg xmlns="http://www.w3.org/2000/svg" class="hidden">
  <symbol id="icon-search" viewbox="0 0 18 19" fill="none">
    <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm.26 1.12a6.78 6.78 0 11.72-.7l5.4 5.4a.5.5 0 11-.71.7l-5.41-5.4z" fill="currentColor"/>
  </symbol>

  <symbol id="icon-reset" class="icon icon-close"  fill="none" viewBox="0 0 18 18" stroke="currentColor">
    <circle r="8.5" cy="9" cx="9" stroke-opacity="0.2"/>
    <path d="M6.82972 6.82915L1.17193 1.17097" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
    <path d="M1.22896 6.88502L6.77288 1.11523" stroke-linecap="round" stroke-linejoin="round" transform="translate(5 5)"/>
  </symbol>

  <symbol id="icon-close" class="icon icon-close" fill="none" viewBox="0 0 18 17">
    <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
  </symbol>
</svg>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    elsif block.type == 'mega_menu' or block.type == 'desktop_link'
      assign has_desktop_menu_blocks = true
    endif
  endfor
-%}

<sticky-header data-responsive-header="v2" data-sticky-type="{{ section.settings.sticky_header_type }}" data-page-type="{{ request.page_type }}" class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}" data-header-transparent="{{ section.settings.transparent_header }}" data-header-transparent-scheme="{{ section.settings.transparent_color_scheme }}" data-header-sticky-scheme="{{ section.settings.sticky_color_scheme }}">
  <header class="header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }} page-width{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}">
    {%- if section.settings.menu != blank -%}
      <header-drawer data-breakpoint="mobile">
        <details id="Details-menu-drawer-container" class="menu-drawer-container" data-header-main-drawer>
          <summary class="header__icon header__icon--menu header__icon--summary link focus-inset" aria-label="{{ 'sections.header.menu' | t }}" data-header-menu-toggle>
            <span>
              {% render 'icon-hamburger' %}
              {% render 'icon-close' %}
            </span>
          </summary>
          <button type="button" class="menu-drawer__backdrop" data-header-drawer-close aria-label="{{ 'accessibility.close' | t }}" tabindex="-1"></button>
          <div id="menu-drawer" class="gradient menu-drawer motion-reduce" tabindex="-1" role="dialog" aria-modal="true" aria-label="{{ 'sections.header.menu' | t }}">
            <div class="menu-drawer__inner-container">
              <div class="menu-drawer__header">
                <a href="{{ routes.root_url }}" class="menu-drawer__logo link link--text focus-inset" aria-label="{{ shop.name | escape }}">
                  {% render 'header-logo' %}
                </a>
                <button type="button" class="menu-drawer__root-close link focus-inset" data-header-drawer-close aria-label="{{ 'accessibility.close' | t }}">
                  <svg class="icon icon-close" aria-hidden="true" focusable="false">
                    <use href="#icon-close"></use>
                  </svg>
                </button>
              </div>
              <div class="menu-drawer__navigation-container">
                <nav class="menu-drawer__navigation">
                  {% render 'header-menu-drawer', links: section.settings.menu.links, section_id: section.id, level: 0 %}
                </nav>
                <div class="menu-drawer__utility-links">
                  {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
                    <div class="menu-drawer__localization header__localization">
                      {%- if section.settings.enable_country_selector -%}
                        <localization-form>
                          {%- form 'localization', id: 'HeaderCountryMobileForm', class: 'localization-form' -%}
                            <div class="no-js-hidden">
                              <h2 class="visually-hidden" id="HeaderCountryMobileLabel">{{ 'localization.country_label' | t }}</h2>
                              {%- render 'country-localization', localPosition: 'HeaderCountryMobile', compact: true -%}
                            </div>
                          {%- endform -%}
                        </localization-form>
                      {% endif %}

                      {%- if section.settings.enable_language_selector -%}
                        <localization-form>
                          {%- form 'localization', id: 'HeaderLanguageMobileForm', class: 'localization-form' -%}
                            <div class="no-js-hidden">
                              <h2 class="visually-hidden" id="HeaderLanguageMobileLabel">{{ 'localization.language_label' | t }}</h2>
                              {%- render 'language-localization', localPosition: 'HeaderLanguageMobile' -%}
                            </div>
                          {%- endform -%}
                        </localization-form>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- liquid
                    assign has_social_links = false
                    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank
                      assign has_social_links = true
                    endif
                  -%}
                  <ul class="list list-social list-unstyled" role="list">
                    {%- if settings.social_twitter_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                          {%- render 'icon-twitter' -%}
                          <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_facebook_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                          {%- render 'icon-facebook' -%}
                          <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_pinterest_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                          {%- render 'icon-pinterest' -%}
                          <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_instagram_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                          {%- render 'icon-instagram' -%}
                          <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_tiktok_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                          {%- render 'icon-tiktok' -%}
                          <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_tumblr_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                          {%- render 'icon-tumblr' -%}
                          <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_snapchat_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                          {%- render 'icon-snapchat' -%}
                          <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_youtube_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                          {%- render 'icon-youtube' -%}
                          <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if settings.social_vimeo_link != blank -%}
                      <li class="list-social__item">
                        <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                          {%- render 'icon-vimeo' -%}
                          <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- unless has_social_links -%}
                      <li class="list-social__item">
                        <span class="list-social__link list-social__link--placeholder" aria-hidden="true">{%- render 'icon-facebook' -%}</span>
                      </li>
                      <li class="list-social__item">
                        <span class="list-social__link list-social__link--placeholder" aria-hidden="true">{%- render 'icon-instagram' -%}</span>
                      </li>
                      <li class="list-social__item">
                        <span class="list-social__link list-social__link--placeholder" aria-hidden="true">{%- render 'icon-youtube' -%}</span>
                      </li>
                      <li class="list-social__item">
                        <span class="list-social__link list-social__link--placeholder" aria-hidden="true">{%- render 'icon-tiktok' -%}</span>
                      </li>
                    {%- endunless -%}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </details>
      </header-drawer>
    {%- endif -%}

    {%- if section.settings.logo_position == 'top-center' or section.settings.menu == blank -%}
      <details-modal class="header__search">
        <details>
          <summary class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle" aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}">
            <span>
              <svg class="modal__toggle-open icon icon-search" aria-hidden="true" focusable="false">
                <use href="#icon-search">
              </svg>
              <svg class="modal__toggle-close icon icon-close" aria-hidden="true" focusable="false">
                <use href="#icon-close">
              </svg>
            </span>
          </summary>
          <div class="search-modal modal__content gradient" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
            <div class="modal-overlay"></div>
            <div class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}" tabindex="-1">
              {%- if settings.predictive_search_enabled -%}
                <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
              {%- else -%}
                <search-form class="search-modal__form">
              {%- endif -%}
                  <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
                    <div class="field">
                      <input class="search__input field__input"
                        id="Search-In-Modal-1"
                        type="search"
                        name="q"
                        value="{{ search.terms | escape }}"
                        placeholder="{{ 'general.search.search' | t }}"
                        {%- if settings.predictive_search_enabled -%}
                          role="combobox"
                          aria-expanded="false"
                          aria-owns="predictive-search-results"
                          aria-controls="predictive-search-results"
                          aria-haspopup="listbox"
                          aria-autocomplete="list"
                          autocorrect="off"
                          autocomplete="off"
                          autocapitalize="off"
                          spellcheck="false"
                        {%- endif -%}
                      >
                      <label class="field__label" for="Search-In-Modal-1">{{ 'general.search.search' | t }}</label>
                      <input type="hidden" name="options[prefix]" value="last">
                      <button type="reset" class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}" aria-label="{{ 'general.search.reset' | t }}">
                        <svg class="icon icon-close" aria-hidden="true" focusable="false">
                          <use xlink:href="#icon-reset">
                        </svg>
                      </button>
                      <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                        <svg class="icon icon-search" aria-hidden="true" focusable="false">
                          <use href="#icon-search">
                        </svg>
                      </button>
                    </div>

                    {%- if settings.predictive_search_enabled -%}
                      <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                        <div class="predictive-search__loading-state">
                          <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                          </svg>
                        </div>
                      </div>

                      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                    {%- endif -%}
                  </form>
              {%- if settings.predictive_search_enabled -%}
                </predictive-search>
              {%- else -%}
                </search-form>
              {%- endif -%}
              <button type="button" class="modal__close-button link link--text focus-inset" aria-label="{{ 'accessibility.close' | t }}">
                <svg class="icon icon-close" aria-hidden="true" focusable="false">
                  <use href="#icon-close">
                </svg>
              </button>
            </div>
          </div>
        </details>
      </details-modal>
    {%- endif -%}

    {%- if section.settings.logo_position != 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {% render 'header-logo', transparent_logo: section.settings.transparent_logo %}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    {%- if has_desktop_menu_blocks -%}
      <nav class="header__inline-menu helix-desktop-nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="list-menu list-menu--inline" role="list">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'mega_menu' -%}
                {%- if block.settings.title != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <header-menu class="helix-header-menu">
                      <details id="Details-HeaderMegaBlock-{{ block.id }}" class="mega-menu helix-mega-menu">
                        <summary class="header__menu-item list-menu__item link focus-inset" aria-controls="MegaMenu-Content-{{ block.id }}">
                          <span class="header__menu-label">{{ block.settings.title | escape }}</span>
                          {% render 'icon-caret' %}
                        </summary>
                        <div id="MegaMenu-Content-{{ block.id }}" class="helix-mega-menu__content motion-reduce" tabindex="-1">
                          {% render 'header-mega-menu-panel', block: block %}
                        </div>
                      </details>
                    </header-menu>
                  </li>
                {%- endif -%}
              {%- when 'desktop_link' -%}
                {%- if block.settings.title != blank -%}
                  <li {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="helix-desktop-nav__link link focus-inset">
                      {{ block.settings.title | escape }}
                    </a>
                  </li>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- elsif section.settings.menu != blank -%}
      {%- if section.settings.menu_type_desktop == 'dropdown' -%}
        <nav class="header__inline-menu">
          <ul class="list-menu list-menu--inline" role="list">
            {%- for link in section.settings.menu.links -%}
              <li>
                {%- if link.links != blank -%}
                  <header-menu>
                    <details id="Details-HeaderMenu-{{ forloop.index }}">
                      <summary class="header__menu-item list-menu__item link focus-inset">
                        <span class="header__menu-label{% if link.child_active %} header__active-menu-item{% endif %}"><a href="{{ link.url }}">{{ link.title | escape }}</a></span>
                        {% render 'icon-caret' %}
                      </summary>
                      <ul id="HeaderMenu-MenuList-{{ forloop.index }}" class="header__submenu list-menu list-menu--disclosure gradient caption-large motion-reduce global-settings-popup" role="list" tabindex="-1">
                        {%- for childlink in link.links -%}
                          <li>
                            {%- if childlink.links == blank -%}
                              <a href="{{ childlink.url }}" class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if childlink.current %} list-menu__item--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                {{ childlink.title | escape }}
                              </a>
                            {%- else -%}
                              <details id="Details-HeaderSubMenu-{{ forloop.index }}">
                                <summary class="header__menu-item link link--text list-menu__item focus-inset caption-large">
                                  <span>{{ childlink.title | escape }}</span>
                                  {% render 'icon-caret' %}
                                </summary>
                                <ul id="HeaderMenu-SubMenuList-{{ forloop.index }}" class="header__submenu list-menu motion-reduce">
                                  {%- for grandchildlink in childlink.links -%}
                                    <li>
                                      <a href="{{ grandchildlink.url }}" class="header__menu-item list-menu__item link link--text focus-inset caption-large{% if grandchildlink.current %} list-menu__item--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                        {{ grandchildlink.title | escape }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </details>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  </header-menu>
                {%- else -%}
                  <a href="{{ link.url }}" class="header__menu-item list-menu__item link link--text focus-inset"{% if link.current %} aria-current="page"{% endif %}>
                    <span {%- if link.current %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- elsif section.settings.menu_type_desktop != 'drawer' -%}
        <nav class="header__inline-menu">
          <ul class="list-menu list-menu--inline" role="list">
            {%- for link in section.settings.menu.links -%}
              <li>
                {%- if link.links != blank -%}
                  <header-menu>
                    <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu">
                      <summary class="header__menu-item list-menu__item link focus-inset">
                        <span class="header__menu-label{% if link.child_active %} header__active-menu-item{% endif %}"><a href="{{ link.url }}">{{ link.title | escape }}</a></span>
                        {% render 'icon-caret' %}
                      </summary>
                      <div id="MegaMenu-Content-{{ forloop.index }}" class="mega-menu__content gradient motion-reduce global-settings-popup" tabindex="-1">
                        <ul class="mega-menu__list page-width{% if link.levels == 1 %} mega-menu__list--condensed{% endif %}" role="list">
                          {%- for childlink in link.links -%}
                            <li>
                              <a href="{{ childlink.url }}" class="mega-menu__link mega-menu__link--level-2 link{% if childlink.current %} mega-menu__link--active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                                {{ childlink.title | escape }}
                              </a>
                              {%- if childlink.links != blank -%}
                                <ul class="list-unstyled" role="list">
                                  {%- for grandchildlink in childlink.links -%}
                                    <li>
                                      <a href="{{ grandchildlink.url }}" class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                                        {{ grandchildlink.title | escape }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </details>
                  </header-menu>
                {%- else -%}
                  <a href="{{ link.url }}" class="header__menu-item list-menu__item link link--text focus-inset"{% if link.current %} aria-current="page"{% endif %}>
                    <span {%- if link.current %} class="header__active-menu-item"{% endif %}>{{ link.title | escape }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.logo_position == 'middle-center' -%}
      {%- if request.page_type == 'index' -%}
        <h1 class="header__heading">
      {%- endif -%}
          <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
            {% render 'header-logo', transparent_logo: section.settings.transparent_logo %}
          </a>
      {%- if request.page_type == 'index' -%}
        </h1>
      {%- endif -%}
    {%- endif -%}

    <div class="header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header__localization{% endif %}">
      <div class="desktop-localization-wrapper">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
              <div class="no-js-hidden">
                <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {% endif %}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form class="small-hide medium-hide">
            {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
              <div class="no-js-hidden">
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      <details-modal class="header__search">
        <details>
          <summary class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle" aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}">
            <span>
              <svg class="modal__toggle-open icon icon-search" aria-hidden="true" focusable="false">
                <use href="#icon-search">
              </svg>
              <svg class="modal__toggle-close icon icon-close" aria-hidden="true" focusable="false">
                <use href="#icon-close">
              </svg>
            </span>
          </summary>
          <div class="search-modal modal__content gradient" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
            <div class="modal-overlay"></div>
            <div class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}" tabindex="-1">
              {%- if settings.predictive_search_enabled -%}
                <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
              {%- else -%}
                <search-form class="search-modal__form">
              {%- endif -%}
                  <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
                    <div class="field">
                      <input class="search__input field__input"
                        id="Search-In-Modal"
                        type="search"
                        name="q"
                        value="{{ search.terms | escape }}"
                        placeholder="{{ 'general.search.search' | t }}"
                        {%- if settings.predictive_search_enabled -%}
                          role="combobox"
                          aria-expanded="false"
                          aria-owns="predictive-search-results"
                          aria-controls="predictive-search-results"
                          aria-haspopup="listbox"
                          aria-autocomplete="list"
                          autocorrect="off"
                          autocomplete="off"
                          autocapitalize="off"
                          spellcheck="false"
                        {%- endif -%}
                      >
                      <label class="field__label" for="Search-In-Modal">{{ 'general.search.search' | t }}</label>
                      <input type="hidden" name="options[prefix]" value="last">
                      <button type="reset" class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}" aria-label="{{ 'general.search.reset' | t }}">
                        <svg class="icon icon-close" aria-hidden="true" focusable="false">
                          <use xlink:href="#icon-reset">
                        </svg>
                      </button>
                      <button class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                        <svg class="icon icon-search" aria-hidden="true" focusable="false">
                          <use href="#icon-search">
                        </svg>
                      </button>
                    </div>

                    {%- if settings.predictive_search_enabled -%}
                      <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
                        <div class="predictive-search__loading-state">
                          <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                            <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                          </svg>
                        </div>
                      </div>

                      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                    {%- endif -%}
                  </form>
                {%- if settings.predictive_search_enabled -%}
                  </predictive-search>
                {%- else -%}
                  </search-form>
                {%- endif -%}
              <button type="button" class="search-modal__close-button modal__close-button link link--text focus-inset" aria-label="{{ 'accessibility.close' | t }}">
                <svg class="icon icon-close" aria-hidden="true" focusable="false">
                  <use href="#icon-close">
                </svg>
              </button>
            </div>
          </div>
        </details>
      </details-modal>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__icon header__icon--account link focus-inset{% if section.settings.menu != blank %} small-hide{% endif %}">
          {% render 'icon-account' %}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {%- liquid
          if cart == empty
            render 'icon-cart-empty'
          else
            render 'icon-cart'
          endif
        -%}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>
    </div>
  </header>
</sticky-header>

{%- if has_desktop_menu_blocks -%}
  <div class="header-mega-shell" aria-hidden="true"></div>
  <button type="button" class="header-mega-overlay" data-header-mega-overlay aria-label="{{ 'accessibility.close' | t }}" tabindex="-1"></button>
{%- endif -%}

{%- if settings.cart_type == "notification" -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: section.settings.menu_type_desktop -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
      this.onScrollHandler = this.onScroll.bind(this);
      this.onResizeHandler = this.onResize.bind(this);
      this.onSectionLoadHandler = this.onSectionLoad.bind(this);
      this.currentScrollTop = 0;
      this.scrollFrame = null;
      this.lastDirectionChange = 0;
      this.heroObserver = null;
      this.heroPassed = false;
      this.heroScrollThreshold = 0;
    }

    connectedCallback() {
      this.header = this.closest('.section-header') || document.querySelector('.section-header');
      this.wrapper = this.matches('.header-wrapper') ? this : this.querySelector('.header-wrapper');
      this.predictiveSearch = this.querySelector('predictive-search');
      this.headerIsAlwaysSticky = true;
      this.headerBounds = {};
      this.isMobile = window.matchMedia('(max-width: 990px)');
      this.isDesignMode = document.documentElement.classList.contains('shopify-design-mode');

      this.setHeaderHeight();
      this.setAnnouncementHeight();
      this.syncHeroReference();
      this.updateHeaderState(true);

      window.addEventListener('scroll', this.onScrollHandler, { passive: true });
      window.addEventListener('resize', this.onResizeHandler, { passive: true });
      document.addEventListener('shopify:section:load', this.onSectionLoadHandler);
      this.addEventListener('preventHeaderReveal', this.preventReveal.bind(this));

      window.requestAnimationFrame(() => {
        this.syncHeroReference();
        this.setAnnouncementHeight();
        this.updateHeaderState(true);
      });
    }

    setHeaderHeight() {
      if (!this.header) return;
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    setAnnouncementHeight() {
      const announcement = this.closest('.shopify-section-group-header-group')?.querySelector('.announcement-bar');
      const announcementHeight = announcement?.closest('.shopify-section')?.getBoundingClientRect().height || 0;
      document.documentElement.style.setProperty('--header-announcement-height', `${Math.round(announcementHeight)}px`);
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.onScrollHandler);
      window.removeEventListener('resize', this.onResizeHandler);
      document.removeEventListener('shopify:section:load', this.onSectionLoadHandler);
      this.heroObserver?.disconnect();
      if (this.scrollFrame) window.cancelAnimationFrame(this.scrollFrame);
    }

    preventReveal() {
      this.preventMobileReveal = true;
      window.clearTimeout(this.preventRevealTimeout);
      this.preventRevealTimeout = window.setTimeout(() => {
        this.preventMobileReveal = false;
      }, 200);
    }

    onSectionLoad() {
      this.syncHeroReference();
      this.setHeaderHeight();
      this.setAnnouncementHeight();
      this.updateHeaderState(true);
    }

    onResize() {
      this.setHeaderHeight();
      this.setAnnouncementHeight();
      this.syncHeroReference();
      this.updateHeaderState(true);
    }

    syncHeroReference() {
      this.heroObserver?.disconnect();
      this.heroObserver = null;
      this.heroPassed = false;
      this.heroScrollThreshold = 0;
      this.hero = null;
      this.heroSection = null;
      if (this.getAttribute('data-page-type') !== 'index' || this.wrapper?.dataset.headerTransparent !== 'true') return;
      this.hero = document.querySelector('#MainContent [data-luxury-hero]');
      this.heroSection = this.hero?.closest('.shopify-section') || null;

      if (this.hero) {
        // Convert the transparent hero header to its white sticky state after 1vh of scroll.
        this.heroScrollThreshold = Math.max(1, Math.round(window.innerHeight * 0.01));
      }

      if (this.heroSection && 'IntersectionObserver' in window) {
        const headerOffset = Math.round(this.header?.getBoundingClientRect().height || 0);
        this.heroObserver = new IntersectionObserver((entries) => {
          const entry = entries[0];
          this.heroPassed = Boolean(!entry.isIntersecting && entry.boundingClientRect.bottom <= headerOffset);
          this.updateHeaderState(true);
        }, {
          rootMargin: `-${headerOffset}px 0px 0px 0px`,
          threshold: [0, 0.01],
        });
        this.heroObserver.observe(this.heroSection);
      }
    }

    onScroll() {
      if (this.predictiveSearch?.isOpen) return;
      if (this.scrollFrame) return;

      this.scrollFrame = window.requestAnimationFrame(() => {
        this.scrollFrame = null;
        this.updateHeaderState(false);
      });
    }

    updateHeaderState(force) {
      if (!this.header) return;

      const scrollTop = Math.max(0, window.pageYOffset || document.documentElement.scrollTop);
      const delta = scrollTop - this.currentScrollTop;
      const atTop = scrollTop <= 4;
      const heroHasEnded = Boolean(this.hero && (this.heroPassed || scrollTop >= Math.max(1, this.heroScrollThreshold)));
      const mobile = this.isMobile.matches;
      const hasHero = Boolean(this.hero);
      const mobileHideThreshold = hasHero ? Math.max(1, this.heroScrollThreshold) : this.header.offsetHeight;

      this.header.classList.toggle('header--hero', hasHero);

      if (hasHero && !heroHasEnded) {
        this.header.classList.remove('header--scrolled', 'header--sticky');
        this.header.classList.remove('header--mobile-hidden');
      } else {
        this.header.classList.toggle('header--scrolled', hasHero && heroHasEnded);
        this.header.classList.toggle('header--sticky', !hasHero || heroHasEnded);

        if (mobile) {
          const passedMobileHideThreshold = scrollTop >= mobileHideThreshold;
          const shouldHideOnDownScroll = !atTop && !this.preventMobileReveal && passedMobileHideThreshold && delta > 0;
          const shouldRevealOnUpScroll = atTop || (!this.preventMobileReveal && delta < 0) || (force && !passedMobileHideThreshold);

          if (shouldHideOnDownScroll) {
            this.header.classList.add('header--mobile-hidden');
            this.closeOpenMenus();
          } else if (shouldRevealOnUpScroll) {
            this.header.classList.remove('header--mobile-hidden');
          }
        }
      }

      if (!mobile) {
        this.header.classList.remove('header--mobile-hidden');
      }

      this.currentScrollTop = scrollTop;
    }

    closeOpenMenus() {
      this.header?.querySelectorAll('header-menu details[open]').forEach(details => {
        window.clearTimeout(details._helixCloseTimer);
        details.classList.remove('is-closing');
        details.removeAttribute('open');
        details.querySelector('summary')?.setAttribute('aria-expanded', 'false');
      });

      this.header?.classList.remove('mega-menu-open', 'mega-menu-closing', 'mega-menu-switching');
      this.header?.style.removeProperty('--header-mega-height');
      this.header?.style.removeProperty('--header-mega-canvas-height');
      this.header?.style.removeProperty('--header-mega-canvas-top');

      this.closeSearchModal();
    }

    closeSearchModal() {
      this.header?.querySelectorAll('details-modal').forEach(searchModal => {
        if (searchModal.isOpen?.()) searchModal.close(false);
      });
    }
  }

  if (!customElements.get('sticky-header')) customElements.define('sticky-header', StickyHeader);

  const desktopMegaMedia = window.matchMedia('(min-width: 991px)');
  const desktopMegaDuration = 300;

  const syncDesktopMegaState = (section, preferredMenu) => {
    if (!section) return;

    const headerWrapper = section.querySelector('sticky-header');
    const headerRect = headerWrapper?.getBoundingClientRect();
    const headerTop = Math.max(0, Math.round(headerRect?.top || 0));
    const headerBottom = Math.max(headerTop, Math.round(headerRect?.bottom || 0));
    const headerHeight = Math.max(0, headerBottom - headerTop);
    section.style.setProperty('--header-mega-top', `${Math.max(0, Math.round(headerBottom))}px`);
    section.style.setProperty('--header-mega-canvas-top', `${headerTop}px`);

    const preferredIsActive = preferredMenu?.open && !preferredMenu.classList.contains('is-closing');
    const openMenu = preferredIsActive
      ? preferredMenu
      : section.querySelector('.helix-mega-menu[open]:not(.is-closing)');
    const closingMenu = section.querySelector('.helix-mega-menu[open].is-closing');

    if (openMenu) {
      const panel = openMenu.querySelector(':scope > .helix-mega-menu__content');
      const inner = panel?.querySelector(':scope > .helix-mega-menu__inner');
      const naturalHeight = Math.max(inner?.scrollHeight || 0, inner?.getBoundingClientRect().height || 0);
      const availableHeight = Math.max(0, window.innerHeight - Math.max(0, headerBottom) - 20);
      const targetHeight = Math.min(Math.ceil(naturalHeight), Math.floor(availableHeight));

      section.style.setProperty('--header-mega-height', `${targetHeight}px`);
      section.style.setProperty('--header-mega-canvas-height', `${headerHeight + targetHeight}px`);
      section.classList.add('mega-menu-open');
      section.classList.remove('mega-menu-closing');
    } else {
      section.classList.remove('mega-menu-open');
      section.classList.toggle('mega-menu-closing', Boolean(closingMenu));

      if (!closingMenu) {
        section.classList.remove('mega-menu-switching');
        section.style.removeProperty('--header-mega-canvas-height');
      }
    }
  };

  const enhanceHeaderMenus = () => {
    document.querySelectorAll('header-menu > details').forEach((details) => {
      if (details.dataset.hoverEnhanced === 'true') return;
      details.dataset.hoverEnhanced = 'true';
      const menu = details.closest('header-menu');
      const summary = details.querySelector(':scope > summary');
      const section = details.closest('.section-header');

      const cancelClose = () => {
        window.clearTimeout(details._helixLeaveTimer);
        window.clearTimeout(details._helixCloseTimer);
        details.classList.remove('is-closing');
      };

      const finishClose = () => {
        window.clearTimeout(details._helixCloseTimer);
        details.classList.remove('is-closing');
        details.removeAttribute('open');
        summary?.setAttribute('aria-expanded', 'false');
        syncDesktopMegaState(section);
      };

      const close = (immediate = false) => {
        if (!details.open) return;

        cancelClose();

        if (immediate || !desktopMegaMedia.matches || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          finishClose();
          return;
        }

        details.classList.add('is-closing');
        summary?.setAttribute('aria-expanded', 'false');
        syncDesktopMegaState(section);
        details._helixCloseTimer = window.setTimeout(finishClose, desktopMegaDuration);
      };

      const requestClose = (delay = 110) => {
        window.clearTimeout(details._helixLeaveTimer);
        details._helixLeaveTimer = window.setTimeout(() => {
          if (details.matches(':hover') || details.contains(document.activeElement)) return;
          close();
        }, delay);
      };

      const open = () => {
        if (!desktopMegaMedia.matches) return;

        cancelClose();
        const openMenus = Array.from(section?.querySelectorAll('header-menu > details[open]') || [])
          .filter((openDetails) => openDetails !== details);
        const isSwitching = openMenus.length > 0;

        if (isSwitching) section?.classList.add('mega-menu-switching');
        details.classList.remove('is-closing');
        details.setAttribute('open', '');
        summary?.setAttribute('aria-expanded', 'true');
        syncDesktopMegaState(section, details);

        openMenus.forEach((openDetails) => {
          window.clearTimeout(openDetails._helixLeaveTimer);
          window.clearTimeout(openDetails._helixCloseTimer);
          openDetails.classList.remove('is-closing');
          openDetails.removeAttribute('open');
          openDetails.querySelector(':scope > summary')?.setAttribute('aria-expanded', 'false');
        });

        syncDesktopMegaState(section, details);

        if (isSwitching) {
          window.clearTimeout(section._helixSwitchTimer);
          section._helixSwitchTimer = window.setTimeout(() => {
            section.classList.remove('mega-menu-switching');
          }, desktopMegaDuration);
        }
      };

      details._helixCloseMenu = close;

      menu?.addEventListener('mouseenter', open);
      menu?.addEventListener('mouseleave', () => requestClose());
      menu?.addEventListener('focusin', open);
      menu?.addEventListener('focusout', () => requestClose(80));
      summary?.addEventListener('click', (event) => {
        if (!desktopMegaMedia.matches) return;
        event.preventDefault();
        open();
      });
      details.addEventListener('toggle', () => {
        if (!details.open) details.classList.remove('is-closing');
        syncDesktopMegaState(section, details.open ? details : null);
      });
    });

    document.querySelectorAll('[data-header-mega-overlay]').forEach((overlay) => {
      if (overlay.dataset.megaOverlayEnhanced === 'true') return;
      overlay.dataset.megaOverlayEnhanced = 'true';
      overlay.addEventListener('click', () => {
        const section = overlay.closest('.section-header');
        section?.querySelectorAll('header-menu > details[open]').forEach((details) => {
          if (typeof details._helixCloseMenu === 'function') {
            details._helixCloseMenu();
          } else {
            details.removeAttribute('open');
            details.querySelector(':scope > summary')?.setAttribute('aria-expanded', 'false');
          }
        });
        syncDesktopMegaState(section);
      });
    });

    document.querySelectorAll('[data-mega-products-track]').forEach((track) => {
      if (track.dataset.sliderEnhanced === 'true') return;
      track.dataset.sliderEnhanced = 'true';
      const wrapper = track.closest('.helix-mega-products');
      const scrollTrack = (direction) => {
        const card = track.querySelector('.helix-mega-product');
        const distance = card ? card.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
        track.scrollBy({ left: direction * distance, behavior: 'smooth' });
      };
      wrapper?.querySelector('[data-mega-products-prev]')?.addEventListener('click', () => scrollTrack(-1));
      wrapper?.querySelector('[data-mega-products-next]')?.addEventListener('click', () => scrollTrack(1));
    });
  };

  enhanceHeaderMenus();
  document.addEventListener('shopify:section:load', enhanceHeaderMenus);

  if (!window.__helixMegaPositionEnhanced) {
    window.__helixMegaPositionEnhanced = true;
    const syncOpenMegaPositions = () => {
      document.querySelectorAll('.section-header.mega-menu-open').forEach(syncDesktopMegaState);
    };
    window.addEventListener('resize', syncOpenMegaPositions);
    window.addEventListener('scroll', syncOpenMegaPositions, { passive: true });
  }

  const enhanceHeaderDrawerLinks = () => {
    document.querySelectorAll('header-drawer .menu-drawer__menu-link').forEach((link) => {
      if (link.dataset.navigationEnhanced === 'true') return;
      link.dataset.navigationEnhanced = 'true';
      link.addEventListener('click', (event) => event.stopPropagation());
    });
  };

  enhanceHeaderDrawerLinks();
  document.addEventListener('shopify:section:load', enhanceHeaderDrawerLinks);

  document.querySelectorAll('header-drawer').forEach((drawer) => {
    if (drawer.dataset.headerEnhanced === 'true') return;
    drawer.dataset.headerEnhanced = 'true';
    const mainDetails = drawer.querySelector(':scope > details');
    const backdrop = mainDetails?.querySelector(':scope > .menu-drawer__backdrop');
    const drawerPanel = mainDetails?.querySelector(':scope > .menu-drawer');

    if (mainDetails && backdrop && backdrop.dataset.drawerBackdropEnhanced !== 'true') {
      backdrop.dataset.drawerBackdropEnhanced = 'true';
      const syncBackdrop = () => {
        const isActive = mainDetails.open && mainDetails.classList.contains('menu-opening');

        if (isActive) {
          if (!backdrop.isConnected && drawerPanel) mainDetails.insertBefore(backdrop, drawerPanel);
          backdrop.hidden = false;
        } else {
          backdrop.hidden = true;
          if (backdrop.isConnected) backdrop.remove();
        }
      };

      drawer._syncHeaderBackdrop = syncBackdrop;
      mainDetails.addEventListener('toggle', syncBackdrop);
      new MutationObserver(syncBackdrop).observe(mainDetails, {
        attributes: true,
        attributeFilter: ['open', 'class'],
      });
    }

    drawer.querySelectorAll('[data-header-drawer-close]').forEach((closeButton) => {
      if (closeButton.dataset.drawerCloseEnhanced === 'true') return;
      closeButton.dataset.drawerCloseEnhanced = 'true';
      closeButton.addEventListener('click', (event) => {
        const mainDetails = drawer.querySelector(':scope > details');
        const summary = mainDetails?.querySelector(':scope > summary');
        if (mainDetails && summary) {
          event.preventDefault();
          event.stopImmediatePropagation();
          drawer.closeMenuDrawer(event, summary);
        }
      }, true);
    });

    drawer._syncHeaderBackdrop?.();

    drawer.querySelectorAll('.menu-drawer__submenu-close-all').forEach((closeButton) => {
      if (closeButton.dataset.drawerCloseEnhanced === 'true') return;
      closeButton.dataset.drawerCloseEnhanced = 'true';
      closeButton.addEventListener('click', (event) => {
        const headerDrawer = event.currentTarget.closest('header-drawer');
        const mainDetails = headerDrawer?.querySelector(':scope > details');
        const summary = mainDetails?.querySelector(':scope > summary');
        if (headerDrawer && mainDetails && summary) {
          event.preventDefault();
          event.stopImmediatePropagation();
          headerDrawer.closeMenuDrawer(event, summary);
        }
      }, true);
    });
  });
{% endjavascript %}

