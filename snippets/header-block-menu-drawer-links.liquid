{%- elsif preset == 'women' or preset == 'men' -%}
  <li><a href="{{ fallback_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Hiking</a></li>
  <li><a href="{{ fallback_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Running</a></li>
  <li><a href="{{ fallback_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Training</a></li>
  <li><a href="{{ fallback_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Tennis</a></li>
  <li><a href="{{ fallback_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Lifestyle</a></li>
  <li><a href="{{ fallback_url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">Shop all</a></li>
{%- endif -%}

{%- if third_menu != blank -%}
  {%- for item in third_menu.links -%}
    <li>
      <a href="{{ item.url }}" class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
        {{ item.title | escape }}
      </a>
    </li>
