{% doc %}
  Renders a recursively nested mobile navigation drawer menu.

  @param {linklist} links - The navigation links to render.
  @param {string} section_id - The header section ID used for unique element IDs.
  @param {number} level - The current menu depth.
{% enddoc %}

<ul class="menu-drawer__menu list-menu{% if level == 0 %} has-submenu{% endif %}" role="list">
  {% for link in links %}
    <li>
      {% if link.links != blank %}
        {% assign submenu_id = 'MenuDrawer-' | append: section_id | append: '-' | append: level | append: '-' | append: forloop.index %}
        <details id="Details-{{ submenu_id }}">
          <summary
            class="menu-drawer__menu-item menu-drawer__menu-item--has-children{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
            aria-label="{{ 'sections.header.open_menu' | t: name: link.title | escape }}"
          >
            <span class="menu-drawer__menu-link menu-drawer__menu-link--parent">
              {{ link.title | escape }}
            </span>
            <span
              class="menu-drawer__submenu-toggle"
              aria-hidden="true"
              tabindex="-1"
            >
              {% render 'icon-caret' %}
            </span>
          </summary>

          <div id="{{ submenu_id }}" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
            <div class="menu-drawer__inner-submenu">
              <div class="menu-drawer__submenu-header">
                <button class="menu-drawer__close-button link link--text focus-inset" type="button">
                  {% render 'icon-caret' %}
                  <span>{{ link.title | escape }}</span>
                </button>
                <button class="menu-drawer__submenu-close-all link focus-inset" type="button" aria-label="{{ 'accessibility.close' | t }}">
                  {% render 'icon-close' %}
                </button>
              </div>
              {% assign next_level = level | plus: 1 %}
              {% render 'header-menu-drawer', links: link.links, section_id: section_id, level: next_level %}
            </div>
          </div>
        </details>
      {% else %}
        <a
          href="{{ link.url }}"
          class="menu-drawer__menu-item list-menu__item link link--text focus-inset{% if link.current %} menu-drawer__menu-item--active{% endif %}"
          {% if link.current %}aria-current="page"{% endif %}
        >
          {{ link.title | escape }}
        </a>
      {% endif %}
    </li>
  {% endfor %}
</ul>
