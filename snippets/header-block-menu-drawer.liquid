{% doc %}
  Renders the mobile navigation from the same section blocks used by the desktop header.

  @param {section.blocks} blocks - Header section blocks.
  @param {string} section_id - Header section ID used for unique element IDs.
{% enddoc %}

<ul class="menu-drawer__menu list-menu has-submenu" role="list">
  {%- for block in blocks -%}
    {%- case block.type -%}
      {%- when 'mega_menu' -%}
        {%- assign submenu_id = 'MenuDrawer-' | append: section_id | append: '-block-' | append: block.id -%}
        <li>
          <details id="Details-{{ submenu_id }}">
            <summary
              class="menu-drawer__menu-item menu-drawer__menu-item--has-children"
              aria-label="{{ 'sections.header.open_menu' | t: name: block.settings.title | escape }}"
            >
              <span class="menu-drawer__menu-label menu-drawer__menu-link--parent">
                {{ block.settings.title | escape }}
              </span>
              <span class="menu-drawer__submenu-toggle" aria-hidden="true" tabindex="-1">
                <svg class="menu-drawer__chevron" viewBox="0 0 7 12" fill="none" focusable="false">
                  <path d="M1 1L6 6L1 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </summary>

            <div id="{{ submenu_id }}" class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
              <div class="menu-drawer__inner-submenu">
                <div class="menu-drawer__submenu-header">
                  <button class="menu-drawer__close-button link link--text focus-inset" type="button">
                    <svg class="menu-drawer__back-icon" viewBox="0 0 7 12" fill="none" aria-hidden="true" focusable="false">
                      <path d="M6 1L1 6L6 11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span>{{ block.settings.title | escape }}</span>
                  </button>
                  <button class="menu-drawer__submenu-close-all link focus-inset" type="button" aria-label="{{ 'accessibility.close' | t }}">
                    {% render 'icon-close' %}
                  </button>
                </div>
                <ul class="menu-drawer__menu list-menu" role="list">
                  {% render 'header-block-menu-drawer-links', block: block %}
                </ul>
              </div>
            </div>
          </details>
        </li>
      {%- when 'desktop_link' -%}
        <li>
          <a
            href="{{ block.settings.link | default: routes.root_url }}"
            class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
          >
            {{ block.settings.title | escape }}
          </a>
        </li>
    {%- endcase -%}
  {%- endfor -%}
</ul>
