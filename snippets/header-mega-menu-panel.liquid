{%- liquid
  assign preset = block.settings.preset | default: 'women'
  assign fallback_url = routes.all_products_collection_url
  assign first_menu = block.settings.column_1_menu
  assign second_menu = block.settings.column_2_menu
  assign third_menu = block.settings.column_3_menu

  assign promo_collection_1 = block.settings.promo_collection_1
  assign promo_collection_2 = block.settings.promo_collection_2
  assign promo_image_1 = block.settings.promo_1_image
  assign promo_image_2 = block.settings.promo_2_image

  if promo_image_1 == blank and promo_collection_1 != blank
    assign promo_image_1 = promo_collection_1.featured_image
    if promo_image_1 == blank
      assign promo_image_1 = promo_collection_1.products.first.featured_image
    endif
  endif

  if promo_image_2 == blank and promo_collection_2 != blank
    assign promo_image_2 = promo_collection_2.featured_image
    if promo_image_2 == blank
      assign promo_image_2 = promo_collection_2.products[1].featured_image
    endif
    if promo_image_2 == blank
      assign promo_image_2 = promo_collection_2.products.first.featured_image
    endif
  endif

  assign promo_title_1 = block.settings.promo_1_title
  if promo_title_1 == blank and promo_collection_1 != blank
    assign promo_title_1 = promo_collection_1.title
  endif

  assign promo_title_2 = block.settings.promo_2_title
  if promo_title_2 == blank and promo_collection_2 != blank
    assign promo_title_2 = promo_collection_2.title
  endif

  assign promo_url_1 = block.settings.promo_1_link
  if promo_url_1 == blank and promo_collection_1 != blank
    assign promo_url_1 = promo_collection_1.url
  endif
  if promo_url_1 == blank
    assign promo_url_1 = fallback_url
  endif

  assign promo_url_2 = block.settings.promo_2_link
  if promo_url_2 == blank and promo_collection_2 != blank
    assign promo_url_2 = promo_collection_2.url
  endif
  if promo_url_2 == blank
    assign promo_url_2 = fallback_url
  endif
-%}

<div class="helix-mega-menu__inner">
  <div class="helix-mega-menu__columns" aria-label="{{ block.settings.title | escape }} submenu">
    {%- if first_menu != blank -%}
      <div class="helix-mega-menu__column{% if block.settings.column_1_bold_links %} helix-mega-menu__column--strong{% endif %}">
        {%- if block.settings.column_1_heading != blank -%}
          <p class="helix-mega-menu__column-heading">{{ block.settings.column_1_heading | escape }}</p>
        {%- endif -%}
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          {%- for item in first_menu.links -%}
            <li><a class="helix-mega-menu__link" href="{{ item.url }}">{{ item.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- elsif preset == 'women' or preset == 'men' -%}
      <div class="helix-mega-menu__column helix-mega-menu__column--strong">
        <p class="helix-mega-menu__column-heading">{{ block.settings.column_1_heading | default: 'Top picks' | escape }}</p>
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Best sellers</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Trending</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">New arrivals</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">On sale</a></li>
        </ul>
      </div>
    {%- elsif preset == 'pages' -%}
      <div class="helix-mega-menu__column">
        <p class="helix-mega-menu__column-heading">{{ block.settings.column_1_heading | default: 'Explore' | escape }}</p>
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          <li><a class="helix-mega-menu__link" href="{{ routes.root_url }}pages/about-us">About us</a></li>
          <li><a class="helix-mega-menu__link" href="{{ routes.root_url }}pages/contact">Contact</a></li>
          <li><a class="helix-mega-menu__link" href="{{ routes.root_url }}pages/faqs">Faqs</a></li>
          <li><a class="helix-mega-menu__link" href="{{ routes.root_url }}pages/store-locations">Store locations</a></li>
          <li><a class="helix-mega-menu__link" href="{{ routes.root_url }}pages/recently-viewed">Recently viewed</a></li>
          <li><a class="helix-mega-menu__link" href="{{ routes.root_url }}blogs/news">Our journal</a></li>
        </ul>
      </div>
    {%- endif -%}

    {%- if second_menu != blank -%}
      <div class="helix-mega-menu__column">
        {%- if block.settings.column_2_heading != blank -%}
          <p class="helix-mega-menu__column-heading">{{ block.settings.column_2_heading | escape }}</p>
        {%- endif -%}
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          {%- for item in second_menu.links -%}
            <li><a class="helix-mega-menu__link" href="{{ item.url }}">{{ item.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- elsif preset == 'women' or preset == 'men' -%}
      <div class="helix-mega-menu__column">
        <p class="helix-mega-menu__column-heading">{{ block.settings.column_2_heading | default: 'By activity' | escape }}</p>
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Hiking</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Running</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Training</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Tennis</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Lifestyle</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Shop all</a></li>
        </ul>
      </div>
    {%- endif -%}

    {%- if third_menu != blank -%}
      <div class="helix-mega-menu__column">
        {%- if block.settings.column_3_heading != blank -%}
          <p class="helix-mega-menu__column-heading">{{ block.settings.column_3_heading | escape }}</p>
        {%- endif -%}
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          {%- for item in third_menu.links -%}
            <li><a class="helix-mega-menu__link" href="{{ item.url }}">{{ item.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </div>
    {%- elsif preset == 'women' or preset == 'men' -%}
      <div class="helix-mega-menu__column">
        <p class="helix-mega-menu__column-heading">{{ block.settings.column_3_heading | default: 'By feature' | escape }}</p>
        <ul class="helix-mega-menu__links list-unstyled" role="list">
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Cushioned</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Waterproof</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Water-resistant</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Breathable</a></li>
          <li><a class="helix-mega-menu__link" href="{{ fallback_url }}">Windproof</a></li>
        </ul>
      </div>
    {%- endif -%}
  </div>

  {%- case block.settings.promo_layout -%}
    {%- when 'products' -%}
      <div class="helix-mega-products">
        <div class="helix-mega-products__header">
          <h3>{{ block.settings.featured_heading | default: 'Best deals 🔥' | escape }}</h3>
          <div class="helix-mega-products__arrows">
            <button type="button" data-mega-products-prev aria-label="Previous products">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
            </button>
            <button type="button" data-mega-products-next aria-label="Next products">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/></svg>
            </button>
          </div>
        </div>
        <div class="helix-mega-products__track" data-mega-products-track>
          {%- if block.settings.featured_collection != blank and block.settings.featured_collection.products_count > 0 -%}
            {%- for product in block.settings.featured_collection.products limit: 4 -%}
              {%- liquid
                assign product_image = product.featured_media.preview_image | default: product.featured_image
                assign discount_percent = 0
                if product.compare_at_price > product.price and product.compare_at_price > 0
                  assign discount_amount = product.compare_at_price | minus: product.price
                  assign discount_percent = discount_amount | times: 100.0 | divided_by: product.compare_at_price | round
                endif
              -%}
              <article class="helix-mega-product">
                <a href="{{ product.url }}" class="helix-mega-product__image-link">
                  {%- if discount_percent > 0 -%}
                    <span class="helix-mega-product__badge">-{{ discount_percent }}%</span>
                  {%- endif -%}
                  {%- if product_image != blank -%}
                    {{ product_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 360, 480, 720', sizes: '(min-width: 1200px) 18vw, 24vw', class: 'helix-mega-product__image' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'helix-mega-product__image placeholder-svg' }}
                  {%- endif -%}
                </a>
                <a href="{{ product.url }}" class="helix-mega-product__title">{{ product.title | escape }}</a>
                <div class="helix-mega-product__price">
                  <span>{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>
              </article>
            {%- endfor -%}
          {%- else -%}
            {%- for index in (1..3) -%}
              <article class="helix-mega-product">
                <div class="helix-mega-product__image-link">{{ 'product-' | append: index | placeholder_svg_tag: 'helix-mega-product__image placeholder-svg' }}</div>
                <span class="helix-mega-product__title">Featured product {{ index }}</span>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

    {%- when 'cards' -%}
      <div class="helix-mega-promos">
        <article class="helix-mega-promo">
          <a href="{{ promo_url_1 }}" class="helix-mega-promo__image-link">
            {%- if promo_image_1 != blank -%}
              {{ promo_image_1 | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100', sizes: '(min-width: 1200px) 24vw, 34vw', class: 'helix-mega-promo__image' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'helix-mega-promo__image placeholder-svg' }}
            {%- endif -%}
          </a>
          <h3><a href="{{ promo_url_1 }}">{{ promo_title_1 | default: "Women's sale" | escape }}</a></h3>
          <a class="helix-mega-promo__cta" href="{{ promo_url_1 }}">
            {{ block.settings.promo_1_label | default: 'Shop now' | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
        <article class="helix-mega-promo">
          <a href="{{ promo_url_2 }}" class="helix-mega-promo__image-link">
            {%- if promo_image_2 != blank -%}
              {{ promo_image_2 | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1100', sizes: '(min-width: 1200px) 24vw, 34vw', class: 'helix-mega-promo__image' }}
            {%- else -%}
              {{ 'collection-2' | placeholder_svg_tag: 'helix-mega-promo__image placeholder-svg' }}
            {%- endif -%}
          </a>
          <h3><a href="{{ promo_url_2 }}">{{ promo_title_2 | default: "Women's favorites" | escape }}</a></h3>
          <a class="helix-mega-promo__cta" href="{{ promo_url_2 }}">
            {{ block.settings.promo_2_label | default: 'Shop now' | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
  {%- endcase -%}
</div>
