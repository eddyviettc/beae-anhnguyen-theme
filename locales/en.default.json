    "beae-section-from-beae": {
      "be76480_html": "N/A",
      "be1970913581_html": "Beosound A1",
      "be862770434_html": "Powerful sound. In the palm of your hand.",
      "be648219503_html": "Delivering a vibrant and powerful sound experience in a compact design, Beosound A1 2nd Gen is the perfect choice for you to enjoy music anytime, anywhere – from outdoor picnics to private relaxing moments.",
      "be282195252_html": "Shop now",
      "be1420586213_html": "SCROLL TO DISCOVER",
      "be375709099_html": "High-end Earphones",
      "be282327618_html": "High-Performance &amp; Elegant Design",
