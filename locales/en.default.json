    "beae-last-homepgae-parrt": {
      "be76480_html": "N/A",
      "be430210269_html": "Tax included. ",
      "be72458158275_html": "<a href=\"{{shop.shipping_policy.url}}\">Shipping</a> calculated at checkout.",
      "be1996109117_html": "-{sale}%",
      "be1538363906_html": "Sold Out",
      "be1197178208_html": "Frequently Asked Questions",
      "be755973345_html": "Answers &amp; Questions",
      "be794801328_html": "From basic inquiries to intricate details, we've collated the most common queries from our user base.",
      "be592772626_html": "What countries do you ship to?",
      "be286248486_html": "Do you have a physical store?",
      "be1677904287_html": "How long will it take to receive my order?",
      "be378803989_html": "Can I return or exchange a product if I'm not satisfied?",
      "be1833613555_html": "How can I get in touch with customer service?",
      "be901494227_html": "We ship to nearly all destinations worldwide.",
      "be113165905107_html": "Yes, we do!<div>You can visit us at:</div><div>📍 The Dome, Cluster N, 1807</div><div>JLT, Dubai, UAE</div>",
      "be1277993722_html": "Standard shipping normally takes 3-5 days.Shipping to Dubai takes 4 hours, while deliveries to the rest of the UAE take between 1 to 2 business days.",
      "be2088932064_html": "Yes, we offer returns and exchanges. Please read our Returns &amp; Exchanges page for more information and terms.",
      "be2058237535_html": "Yes, we have a dedicated technical support team available online. You can contact our customer service at support@hadiaghaleb.com.",
      "be1527333117_html": "OUR CUSTOMER SAY",
      "be883084481910_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">I love the material so much! I can't wait to see the new collection.\r</span></font></div><div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">You know I'm a big fan of her burkinis, and this is the third time I've ordered.\r</span></font></div><div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">Now, I can’t order any burkini except Hadia Ghaleb—the best material, the best design, and truly elegant!\r</span></font></div><div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">Always supporting!</span></font></div>",
      "be32864860_html": "Dina Ibrahim",
      "be1329162270471_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">\"Thank you very much! I received my order yesterday, and it was way beyond my expectations. Amazing quality, elegant wrapping, unique design, and the cut makes my shape look thinner. Thank you, Hadia, for this amazing product, which will definitely add a lot to my self-confidence at the beach. Bless you, dear!\"</span></font></div>",
      "be308523673_html": "Manar Darwish",
      "be1768646548824_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">\"Honest review!</span></font></div><div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">Besides the great light material and the vibrant summer colors which I do love, I have to admit that @hadiaghaleb.com customer service is incredibly professional. I asked for an exchange in size, and within exactly 2 days, I got my new suit. The courier picked up the other one in such a hassle-free procedure.</span></font></div><div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">Impressive service!!!\"</span></font></div>",
      "be1676121991_html": "Dina Daoud",
      "be1852377795293_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">\"Hey Hadia! I just got back from Mykonos and wore your Cosmos swimsuit the whole time—absolutely loved it! So comfy and cute! Thanks!\"</span></font></div>",
      "be1669685149_html": "Donia A. Mohamed",
      "be1879375064458_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">\"Hello there, I just wanted to share my experience with Cherry Blaze. I felt more unique, confident, and super elegant. The material is more than perfect! Some Russian women asked where it was from, and I showed them the page. They were surprised by the fabric and colors and will buy the same one.\"</span></font></div>",
      "be373897040_html": "Mira Mahmoud",
      "be23776929256_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">\"Thank you for the perfect material and the perfect fit. It's really amazing, Hadia! Keep going!\"</span></font></div>",
      "be385015812_html": "Nelly Hesham",
      "be1271849145240_html": "<div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0);\">\" High fashion and high-quality beachwear. Feel and look beautiful at all times.\"</span></font></div>",
      "be1360073363_html": "Hendel Barbary",
      "be1039105699322_html": "<div style=\"text-align: center;\"><span style=\"background-color: rgb(255 255 255 / var(--tw-bg-opacity, 1)); font-weight: var(--p-font-weight-regular); font-size: 16px; caret-color: rgb(0, 0, 0);\"><font color=\"#000000\" face=\"Mulish, sans-serif\">\"It's amazing material! I like it so much! Thanks, Hadia.\"</font></span></div>",
      "be2122512_html": "Dana",
      "be1278217276750_html": "<div style=\"text-align: center;\"><span style=\"background-color: color(srgb 1 1 1); font-size: 16px; caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-family: Mulish, sans-serif; font-weight: var(--p-font-weight-regular);\">Dear @hadiaghaleb, all of my greetings and respect for this amazing, wonderful burkini. Guys, it's amazing material! The waist of the skirt and pants is like a corset, so it makes your body look gorgeous. Also, the color in real life is even more beautiful than in the pictures—it's Barbie colors, and I'm in love!\"</span></div><div style=\"text-align: center;\"><font color=\"#000000\" face=\"Mulish, sans-serif\"><span style=\"font-size: 16px; caret-color: rgb(0, 0, 0); background-color: color(srgb 1 1 1);\">\r</span></font></div>",
      "be1152117703_html": "Shaimaa Aghrib",
