    "beae-faq-test": {
      "be76480_html": "N/A",
      "be430210269_html": "Tax included. ",
      "be72458158275_html": "<a href=\"{{shop.shipping_policy.url}}\">Shipping</a> calculated at checkout.",
      "be2090838752_html": "Frequently asked questions",
      "be1294166218_html": "Track your order",
      "be1005611367_html": "Check your order status",
      "be1480624681_html": "Worldwide shipping",
      "be375778497_html": "Rates available at checkout.",
      "be2119476243_html": "Start a return",
      "be694900499_html": "Our promise to you",
      "be683056275_html": "Gift cards",
      "be502102937_html": "Various denominations",
      "be15619417_html": "24/7 support",
      "be1569797796_html": "1(800) 555-1234.",
      "be1924903163_html": "Orders",
      "be1711672165_html": "What payment methods do you accept?",
      "be1237954001_html": "Can I change or cancel my order after it has been placed?",
      "be266798356_html": "How can I check the status of my order?",
      "be600110707_html": "Do you offer gift wrapping?",
      "be1461964426_html": "We accept a variety of payment methods including credit and debit cards, PayPal, Apple Pay, and Google Pay. For a complete list of accepted payment methods, please refer to our Payment Options section.",
      "be1281839836_html": "If you need to change or cancel your order, please contact us as soon as possible. We will do our best to accommodate your request, but once the order has been processed, we may not be able to make changes.",
      "be1328414887_html": "You can check the status of your order by logging into your account on our website or by using the tracking number provided in your shipping confirmation email.",
      "be1833134453_html": "Yes, we offer gift wrapping for an additional fee. You can select this option at checkout.",
      "be490801518_html": "Shipping &amp; returns",
      "be1106150414_html": "Do you ship internationally?",
      "be1926947591_html": "How can I track my order?",
      "be1784678798_html": "Yes, we ship to over 100 countries worldwide. Shipping costs and delivery times vary depending on the destination. Please visit our Shipping Information page for detailed information about international shipping options and costs.",
      "be1675415201_html": "Once your order is shipped, we will send you an email with a tracking number. You can use this number to track your order directly on our website under the \"Track My Order\" section or through the carrier’s website.",
      "be939117180_html": "Products",
      "be838614432_html": "How do I set up my new device?",
      "be82747389_html": "Do you offer warranties on your products?",
      "be1209429301_html": "Most devices come with a quick start guide in the box. Additionally, we offer online setup guides and tutorials for various products. Check the \"Support\" or \"Tutorials\" section on our website for detailed instructions.",
      "be2120065256_html": "Yes, all our products come with a manufacturer's warranty. The duration and terms of the warranty vary by product and manufacturer. Additional extended warranty options may be available for purchase.",
      "be127662261722_html": "<div>Dining room</div>",
      "be828584947_html": "From elegant dining chairs to stylish tables, discover unbeatable deals on everything you need",
      "be282195252_html": "Shop now",
      "be160628911122_html": "<div>Living room</div>",
      "be15690865777_html": "<div>Limited time only—shop now and create your perfect gathering spot!</div>",
      "be19086692518_html": "<div>Bedroom</div>",
      "be359819825106_html": "<div>From modern platform beds to elegant dressers, discover unbeatable deals on everything you need</div>"
    },
    "beae-faq-test-1": {
      "be76480_html": "N/A",
      "be430210269_html": "Tax included. ",
      "be72458158275_html": "<a href=\"{{shop.shipping_policy.url}}\">Shipping</a> calculated at checkout.",
      "be70390_html": "Faq",
      "be1924903163_html": "Orders",
      "be451591730_html": "Shipping",
      "be1531838173_html": "Returns",
      "be566191388_html": "Warranty",
      "be1151340126_html": "Wholesale",
      "be1779081248_html": "Gift card",
      "be1715472684_html": "How do I track my order?",
      "be26795769_html": "Can I cancel or modify my order after it has been placed?",
      "be638496328_html": "What should I do if I receive a damaged or incorrect item?",
      "be1037469491_html": "You can track your order by logging into your account on our website and navigating to the \"My Orders\" section. There, you'll find the tracking number for your order, which you can use to track the shipment on the carrier's website.",
      "be365384599_html": "If you receive a damaged or incorrect item, please contact our customer service team within 48 hours of receiving your order. Provide them with your order number, a description of the issue, and any relevant photos. We will arrange for a replacement or refund as soon as possible.",
      "be2048350958_html": "What are your shipping options?",
      "be1106150414_html": "Do you ship internationally?",
      "be1792164541_html": "How do I qualify for free shipping?",
      "be466721596_html": "We offer several shipping options to meet your needs, including standard shipping, expedited shipping, and express shipping. During checkout, you can select your preferred shipping method and see the estimated delivery times and costs.",
      "be1336857493_html": "Yes, we do ship internationally. Please note that shipping rates and delivery times may vary depending on the destination country. Any customs duties or taxes are the responsibility of the recipient.",
      "be1349157007242_html": "<div>Free shipping is available for orders over a certain amount, which varies by promotion. Please check our current promotions or the shipping information page on our website for the latest details on how to qualify for free shipping.</div>",
      "be682008240_html": "What is your return policy?",
      "be1842113165_html": "How do I return an item?",
      "be389340286_html": "Will I have to pay for return shipping?",
      "be2030388241_html": "Our return policy allows you to return items within 30 days of receipt for a full refund or exchange. Items must be in their original condition and packaging. Please contact our customer service team to initiate a return.",
      "be1477028913_html": "To return an item, please contact our customer service team to obtain a return authorization number and return instructions. Pack the item securely in its original packaging and include the return authorization number inside the package. Ship the item to the address provided by our customer service team.",
      "be8152942_html": "If you are returning an item due to damage, defect, or an error on our part, we will cover the return shipping costs. For all other returns, you will be responsible for the return shipping costs. We recommend using a trackable shipping method to ensure your return is received.",
      "be1238954564_html": "What is your warranty policy?",
      "be1031936896_html": "How do I file a warranty claim?",
      "be2030309266_html": "Are there any exclusions to the warranty?",
      "be1522656226272_html": "<div>We offer a one-year warranty on all our products. This warranty covers any manufacturing defects or issues with materials and workmanship. If you experience any problems with your item within this period, please contact our customer service team for assistance.</div>",
      "be966078355_html": "To file a warranty claim, please contact our customer service team with your order number, a description of the issue, and any relevant photos. Our team will review your claim and provide you with further instructions on how to proceed.",
      "be998406181_html": "Yes, our warranty does not cover damage caused by misuse, improper care, accidents, or normal wear and tear. It also does not cover any modifications or repairs made by unauthorized personnel. For more detailed information, please refer to our full warranty policy on our website.",
      "be1351744183_html": "Whosesale",
      "be895801067_html": "Do you offer wholesale pricing?",
      "be49007762_html": "What is the minimum order quantity for wholesale purchases?",
      "be1680148066_html": "How do I set up a wholesale account?",
      "be2039444664_html": "Yes, we offer competitive wholesale pricing for bulk orders. If you are interested in purchasing our products at wholesale prices, please contact our wholesale team with your business details and the products you are interested in.",
      "be745611738_html": "The minimum order quantity for wholesale purchases varies depending on the product. Please contact our wholesale team for specific information on the minimum order quantities for the items you are interested in.",
      "be119270843_html": "To set up a wholesale account, please fill out our wholesale application form on our website. Once your application is reviewed and approved, you will receive a confirmation email with details on how to access our wholesale pricing and place orders.",
      "be1546195698_html": "Do you offer gift cards?",
      "be1009603366_html": "How do I redeem a gift card?",
      "be247809360_html": "Can I use multiple gift cards for one purchase?",
      "be1479498142_html": "Yes, we offer digital gift cards in various denominations. They can be purchased directly from our website and sent to the recipient via email, making them a perfect gift for any occasion.",
      "be687063099_html": "To redeem a gift card, enter the unique gift card code at checkout in the \"Gift Card\" field. The value of the gift card will be applied to your order total. If the purchase amount exceeds the gift card balance, you can pay the remaining balance using another payment method.",
      "be1958784045_html": "Yes, you can use multiple gift cards for a single purchase. Simply enter each gift card code one at a time in the \"Gift Card\" field at checkout. The total value of all entered gift cards will be applied to your order.",
      "be1583670354_html": "Faq Test 123"
    },
