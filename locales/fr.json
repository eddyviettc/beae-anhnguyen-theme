      "be1961221788_html": "{{ unavailable_icon }} Retrait actuellement indisponible à {{ location_name }}",
      "be2255103_html": "Accueil",
      "be77694213_html": "Sans titre",
      "be474778094_html": "Approuvé par des milliers d'amateurs de fitness dans le monde entier",
      "be89654742_html": "L'une des machines d'entraînement à domicile les plus vendues",
      "be1716999121_html": "Parfait pour la perte de poids, la force et l'entraînement cardio",
      "be978022322_html": "À partir de {{ price_min }}",
      "be145511085251_html": "Plus de 3 000 personnes ont acheté le mois dernier\n<div><br></div>",
      "be40552923329_html": "<div>Entraînement Complet du Corps</div>",
      "be1197338265_html": "Formule Naturelle Qui A Bon Goût",
      "be1191201615_html": "Prévient les infections et équilibre le pH naturellement",
      "be849688199_html": "Économisez {sale}%",
      "be1220360021_html": "Quantité",
      "be649020154_html": "Ajouter au panier",
      "be28375103_html": "Rupture de stock",
      "be1182278043_html": "Ajouté au panier",
      "be1538394658_html": "Épuisé",
      "be1427617666_html": "Ajouté au panier avec succès",
      "be719299147_html": "Choisir des options",
      "be56677412_html": "Description",
      "be1687162401_html": "Pourquoi choisir cette machine à squats ?",
      "be974922461_html": "Pour qui c'est fait :",
      "be1550717783_html": "Expédition et retours",
      "be831528510359_html": "✅ Plus sûr que les squats avec barre libre pour les genoux et le dos\r<div>\r</div><div>✅ Idéal pour les débutants, les seniors et l'entraînement à faible impact\r</div><div>✅ Compact et pliable pour les espaces réduits\r</div><div>✅ Cible l'ensemble du bas du corps et le tronc en un seul mouvement simple\r</div><div>✅ Parfait pour les routines de gym à domicile, la réhabilitation et les échauffements complets</div><div>\r</div><div>\r</div><div>\r</div>",
      "be749763306315_html": "Femmes cherchant à tonifier les fessiers et les jambes\r<div>\r</div><div>Hommes visant à développer une force fonctionnelle du bas du corps\r</div><div>Seniors et patients en réhabilitation ayant besoin d'exercices respectueux des articulations\r</div><div>Quiconque souhaitant un entraînement rapide du bas du corps complet sans poids lourds\r</div><div>&nbsp;</div><div>\r</div><div>\r</div><div>\r</div>",
      "be18852344_html": "<br>",
      "be824281820_html": "Caractéristiques clés :",
      "be220498230644_html": "Résistance à ressort ou en caoutchouc : Soutient votre mouvement de squat avec une résistance lisse et réglable pour réduire la tension sur les genoux et le dos.\r<div>\r</div><div>Design Ergonomique : Siège et dossier rembourrés favorisent une posture correcte et la stabilité à chaque répétition.\r</div><div>Guidon Multi-Position : Offre plusieurs options de prise pour l'équilibre et une activation optionnelle du haut du corps.\r</div><div>Pliable et Gain de Place : Se plie facilement pour un rangement compact—parfait pour les appartements, les salles de sport à domicile ou les petits espaces d'entraînement.\r</div><div>Cadre en Acier Durable : Construction robuste supporte jusqu'à 120–150kg, conçu pour un usage à long terme.</div><div>\r</div><div>\r</div><div>\r</div>",
      "be233204646_html": "Passionnés de Fitness à Domicile",
      "be165214872_html": "Ajoutez une ligne de tag",
      "be1942531745_html": "Image avec des colonnes de texte",
      "be2023997302_html": "Colonne",
      "be347608833128_html": "Associez du texte à une image pour mettre en avant votre produit, collection ou article de blog choisi.<div>Ajoutez des détails sur la disponibilité, le style.</div>"
    },
